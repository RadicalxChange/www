/* all statements at least 7 in 10 of every group agreed with, highest shared support first */
const SHARED = [[53,"People coming to Australia were expected to respect democratic principles, the rule of law and the rights and freedoms of others.",92,96,95,183,75,21],[12,"For seasonal work like seeding and harvest, short-term visas work well: people come, do the hard work, get paid and move on.",77,90,77,194,78,22],[39,"Australia should plan and invest in transport, schools and healthcare ahead of population growth so communities are ready.",85,88,77,192,78,22],[78,"I’d trust the migration system more if Australians were given clear, honest information about its economic benefits and costs.",84,81,76,174,79,21],[0,"I'd trust migration more if it was planned 10 to 15 years ahead for what the country needs, not around the three-year election cycle.",76,77,82,196,82,22],[71,"Migration policy should serve the broader public interest, not primarily the needs of business.",89,74,96,170,74,23],[70,"Population growth should not come at the expense of productive farmland and native species.",76,71,90,190,72,21],[74,"Temporary migration programs need strong safeguards against worker exploitation and coercion.",97,82,70,172,74,20]];
const allRoot = document.getElementById('all');
SHARED.forEach(([id, t, a, b, c, na, nb, nc]) => {
