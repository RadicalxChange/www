/* ================= priorities ================= */
const QV = [
  { t: 'Plan migration together with housing and infrastructure, so new arrivals are matched by homes and services.', y: 46, n: 3, net: 148, e: [9, 'I\'d trust the system more if housing, roads, schools and hospitals kept pace with how many people move into our area.', 78, 90, 55] },
