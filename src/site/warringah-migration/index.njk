  const yBr = base - bracketH;
  el('path', { class: 'st-bracket', d: `M${g2Left.toFixed(1)},${(yBr + brTick).toFixed(1)} V${yBr.toFixed(1)} H${hi.toFixed(1)} V${(yBr + brTick).toFixed(1)}`, fill: 'none', 'stroke-width': (1.4 * k).toFixed(2) }, stanceLayer);
  el('line', { class: 'st-div', x1: sx.toFixed(1), x2: sx.toFixed(1), y1: yBr.toFixed(1), y2: y0.toFixed(1), 'stroke-width': (1.4 * k).toFixed(2), 'stroke-dasharray': `${(3 * k).toFixed(1)} ${(3.5 * k).toFixed(1)}` }, stanceLayer);
