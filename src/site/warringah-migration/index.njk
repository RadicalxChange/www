  const groupLabel = (gi, cx, name, count) => {
    const g = el('g', { class: 'grp' }, stanceLayer);
    el('title', {}, g).textContent = `${name}: ${count} people`;
    const yName = base - bandH - (narrow ? 0 : fsC * 1.15 + 4 * k);
    const t = text('grp-name', cx, yName, fsG, narrow ? NAME[gi] : name, g);
    const r = fsG * .3, wd = t.getComputedTextLength(), shift = (r * 2 + 6 * k) / 2;
    t.setAttribute('x', (cx + shift).toFixed(1));
    el('circle', { cx: (cx + shift - wd / 2 - r - 6 * k).toFixed(1), cy: (yName - fsG * .34).toFixed(1), r: r.toFixed(1), fill: gi ? 'var(--g2)' : 'var(--g1)' }, g);
