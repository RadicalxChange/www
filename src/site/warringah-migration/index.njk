  { topic: 'Put the public interest first', split: [16, 'Employers with a genuine shortage should be able to sponsor a worker quickly, without paying a migration agent a fortune to get through the process.', 85, 70, 26, 206, 82, 23], agree: [71, 'Migration policy should serve the broader public interest, not primarily the needs of business.', 89, 74, 96, 170, 74, 23] }
];
const pairsRoot = document.getElementById('pairs');
PAIRS.forEach(p => {
  const d = document.createElement('article'); d.className = 'pair';
  d.innerHTML = `<div class="topic"><h3></h3><span class="n">Statements ${p.split[0]} and ${p.agree[0]}</span></div>
    <div class="half split-half"><span class="pill">They disagree on</span><q></q></div>
    <div class="half agree"><span class="pill">But all three back</span><q></q></div>`;
  d.querySelector('h3').textContent = p.topic;
  const [qs, qa] = d.querySelectorAll('q'); qs.textContent = p.split[1]; qa.textContent = p.agree[1];
