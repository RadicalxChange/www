function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
const DATA = JSON.parse(document.getElementById('page-data').textContent);
const NAME = ['Group 1', 'Group 2'], FULL = DATA.names.map((n, i) => `Group ${i + 1}: ${n}`);   // names come from the generator
const AXIS_L = DATA.names[0], AXIS_R = DATA.names[1], AXIS_R_SHORT = DATA.short[1];

/* ================= map: one row along the main divide ================= */
const MW = 1000, PL = 24, PR = 24, PT = 12;
let MH = 300;
const svg = document.getElementById('map');
const mapCardEl = document.getElementById('map-card');
const people = DATA.people.map(([x, g, nv, ar, nc, l1, l2, e1, v1, e2, v2], i) => {
  const n = l1 + l2, own = g === 0 ? l1 : l2;
  return { i, g, nv, ar, nc, l1, l2, n, e1, v1, e2, v2, dv: x, share: n ? own / n : null, x: 0, y: 0 };
});
const finalFill = p => p.g === 0 ? 'var(--g1)' : 'var(--g2)';
const defs = el('defs', {}, svg);
const mk = el('marker', { id: 'arr', viewBox: '0 0 10 10', refX: 8, refY: 5, markerWidth: 7, markerHeight: 7, orient: 'auto-start-reverse' }, defs);
el('path', { d: 'M0,0 L10,5 L0,10 z', fill: 'var(--ink)' }, mk);
const axisLayer = el('g', {}, svg);
const labelLayer = el('g', { class: 'glabels' }, svg);
const dotLayer = el('g', {}, svg);
const dots = people.map(p => el('circle', { r: 5, cx: 0, cy: 0, class: 'pdot', fill: finalFill(p) }, dotLayer));
const ring = el('circle', { r: 9, fill: 'none', stroke: 'var(--ink)', 'stroke-width': 3, opacity: 0, 'pointer-events': 'none' }, svg);
let settled = false;
// Rounded heaps along the main divide (the layout the other results pages use): each dot drops near its true
// place on the line and rolls a little to the lowest free spot, up to `reach` dot widths either way, paying
// `slope` for every step it moves sideways, so crowded stretches pile up like sand, not in columns. Kooyong has
// no divider inside a group, so dots drop left to right. With fewer than 100 people, the dots are drawn larger
// (7px, or 3.6px in the phone layout), as on the Southern Highlands page, so the map isn't a thin line.
function swarm(w) {
  const k = MW / w, narrow = w < 640 && window.matchMedia('(max-width: 900px)').matches, r = (narrow ? 3.6 : 7) * k, D = 2 * r + Math.max(1, .7 * k);
  const lo = PL + r, hi = MW - PR - r, reach = narrow ? 4 : 3, slope = narrow ? .7 : .9, placed = [];
  let top = 0;
  people.slice().sort((a, b) => a.dv - b.dv || a.i - b.i).forEach(p => {
    const tx = lo + p.dv * (hi - lo);
    const local = placed.filter(q => Math.abs(q.x - tx) < (reach + 1.2) * D);
    let best = null;
    for (let s = -reach; s <= reach + .001; s += .25) {
      const x = Math.min(hi, Math.max(lo, tx + s * D));
      const near = local.filter(q => Math.abs(q.x - x) < D);
      const cands = [0].concat(near.map(q => q.h + Math.sqrt(Math.max(0, D * D - (q.x - x) ** 2)))).sort((a, b) => a - b);
      const h = cands.find(c => near.every(q => (q.x - x) ** 2 + (q.h - c) ** 2 >= D * D - .5)) || 0;
      const score = h + slope * Math.abs(x - tx);
      if (!best || score < best.score) best = { x, h, score };
    }
    placed.push({ i: p.i, x: best.x, h: best.h }); top = Math.max(top, best.h);
  });
  const fs = Math.max(17, 12.5 * k), axisH = Math.max(66, fs * 2.6);
  return { k, r, narrow, lo, hi, top, fs, axisH, placed };
}
// a layout in map units, leaving `headroom` above the tallest heap for labels
function frame(sw, headroom) {
  const H = Math.ceil(PT + headroom + sw.top + 2 * sw.r + sw.axisH), base = H - sw.axisH;
  return { H, base, pos: sw.placed.map(q => ({ i: q.i, x: q.x, y: base - sw.r - q.h })) };
}
function axis(layer, w, axY, fs, marker) {
  el('line', { x1: PL, x2: MW - PR - 4, y1: axY, y2: axY, class: 'axis', 'marker-start': `url(#${marker})`, 'marker-end': `url(#${marker})` }, layer);
  const lab = (txt, attrs) => { const t = el('text', Object.assign({ class: 'axis-label' }, attrs), layer); t.style.fontSize = fs + 'px'; t.textContent = txt; return t; };
  const lt = lab(AXIS_L, { x: PL, y: axY + fs * 1.6 });
  const rt = lab(w < 640 ? AXIS_R_SHORT : AXIS_R, { x: MW - PR, y: axY + fs * 1.6, 'text-anchor': 'end' });
  const room = MW - PL - PR - 40, used = lt.getBBox().width + rt.getBBox().width;  // never let the two labels touch
  if (used > room) [lt, rt].forEach(t => t.style.fontSize = (fs * room / used).toFixed(1) + 'px');
}
function layout() {
  const w = svg.clientWidth || MW, sw = swarm(w), k = sw.k, r = sw.r, narrow = sw.narrow, lo = sw.lo, hi = sw.hi;
  // each group's name (and count, on wide screens) over its own heap, both on one line
  const fsG = (narrow ? 12.5 : 17) * k, fsC = (narrow ? 11 : 14) * k;
  const at = v => lo + v * (hi - lo);
  const spans = [0, 1].map(g => { const xs = people.filter(p => p.g === g).map(p => p.dv).sort((a, b) => a - b);
    const a = at(xs[Math.floor(xs.length * .1)]), b = at(xs[Math.floor(xs.length * .9)]); return { c: (a + b) / 2, hw: Math.max((b - a) / 2, 40 * k) }; });
  const peak = (x, hw) => Math.max(0, ...sw.placed.filter(q => Math.abs(q.x - x) <= hw).map(q => q.h + 2 * r));
  const grpH = narrow ? fsG * 1.25 : fsG * 1.25 + fsC * 1.15 + 4 * k;
  const bandH = Math.max(peak(spans[0].c, spans[0].hw), peak(spans[1].c, spans[1].hw)) + 10 * k;
  const fr = frame(sw, Math.max(0, bandH + grpH - sw.top - 2 * r)), base = fr.base;
  MH = fr.H;
  svg.setAttribute('viewBox', `0 0 ${MW} ${MH}`);
  fr.pos.forEach(q => { people[q.i].x = q.x; people[q.i].y = q.y; });
  while (axisLayer.firstChild) axisLayer.removeChild(axisLayer.firstChild);
  const axY = base + 8;
  axis(axisLayer, w, axY, sw.fs, 'arr');
  while (labelLayer.firstChild) labelLayer.removeChild(labelLayer.firstChild);
  const text = (cls, x, y, size, str, g, anchor = 'middle') => { const t = el('text', { class: cls, x: x.toFixed(1), y: y.toFixed(1), 'text-anchor': anchor }, g); t.style.fontSize = size + 'px'; t.textContent = str; return t; };
  [0, 1].forEach(gi => {
    const count = people.filter(p => p.g === gi).length, cx = spans[gi].c;
    const g = el('g', { class: 'grp' }, labelLayer);
    el('title', {}, g).textContent = `${FULL[gi]}: ${count} people`;
    const yName = base - bandH - (narrow ? 0 : fsC * 1.15 + 4 * k);
    const t = text('grp-name', cx, yName, fsG, narrow ? NAME[gi] : FULL[gi], g);
    const dr = fsG * .3, gap = 6 * k, wd = t.getComputedTextLength(), total = 2 * dr + gap + wd;
    const left = Math.min(Math.max(cx - total / 2, PL), MW - PR - total), tx = left + 2 * dr + gap + wd / 2;
    t.setAttribute('x', tx.toFixed(1));
    el('circle', { cx: (left + dr).toFixed(1), cy: (yName - fsG * .34).toFixed(1), r: dr.toFixed(1), fill: gi ? 'var(--g2)' : 'var(--g1)' }, g);
    if (!narrow) text('grp-count', tx, base - bandH, fsC, count + ' people', g);
  });
  dots.forEach(d => d.setAttribute('r', r.toFixed(2)));
  ring.setAttribute('r', (r + 4 * k).toFixed(1));
  ring.setAttribute('stroke-width', (2 * k).toFixed(1));
  if (settled) { dots.forEach((d, i) => { d.style.transition = 'none'; d.style.transform = `translate(${people[i].x}px, ${people[i].y}px)`; }); svg.getBoundingClientRect(); dots.forEach(d => d.style.transition = ''); }
  hidePerson && hidePerson();
}
function placeAll(final) {
  dots.forEach((d, i) => {
    const p = people[i];
    const x = final ? p.x : MW / 2 + (Math.sin(i * 12.9898) * 43758.5453 % 1) * 200;
    const y = final ? p.y : (MH - 66) / 2 + (Math.sin(i * 78.233) * 12345.678 % 1) * 50;
    d.style.transform = `translate(${x}px, ${y}px)`;
  });
  if (final) settled = true;
}
var hidePerson = null;
layout();
let lastW = svg.clientWidth;
window.addEventListener('resize', () => { clearTimeout(window.__rz); window.__rz = setTimeout(() => { if (svg.clientWidth !== lastW) { lastW = svg.clientWidth; layout(); } }, 150); });
if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { lastW = svg.clientWidth; layout(); });
if (reduce || !('IntersectionObserver' in window)) { placeAll(true); }
else {
  dots.forEach(d => { d.style.transition = 'none'; d.style.opacity = .35; d.style.fill = 'var(--muted)'; });
  placeAll(false);
  svg.getBoundingClientRect();
  const io = new IntersectionObserver(es => { if (!es[0].isIntersecting) return; io.disconnect();
    dots.forEach((d, i) => { d.style.transition = ''; d.style.transitionDelay = ((i * 37 % 100) / 220).toFixed(2) + 's'; });
    requestAnimationFrame(() => placeAll(true));
    setTimeout(() => dots.forEach((d, i) => { d.style.transitionDelay = '0s'; d.style.opacity = 1; d.style.fill = finalFill(people[i]); }), 1500);
  }, { threshold: .35 });
  io.observe(svg);
}

// person card
const card = document.getElementById('person');
let current = -1;
const VERB = { a: 'agreed', d: 'disagreed' };
function example(id, v, side) {
  if (id < 0) return '';
  return `<div class="ex"><p class="exl"><i class="dot ${side ? 'g2' : 'g1'}"></i>Like ${NAME[side]}, they ${VERB[v]}:</p><q>${esc(DATA.texts[String(id)])}</q></div>`;
}
function showPerson(i) {
  if (i === current && card.classList.contains('on')) return;
  current = i; const p = people[i], me = p.g, other = 1 - p.g;
  const wrote = p.nc > 0 ? `, and wrote <b>${p.nc}</b> of their own` : '';
  let html = `<p class="pg"><i class="dot ${me ? 'g2' : 'g1'}"></i>${FULL[me]}</p>
    <p class="pn">Voted on <b>${p.nv}</b> statements, agreeing with <b>${p.ar}%</b>${wrote}.</p>`;
  if (p.n === 0) {
    html += `<p class="note">They didn’t vote on any of the ${DATA.nsplit} statements where the groups took opposite sides, so they were placed using their other votes.</p>`;
  } else {
    const w1 = (p.l1 / p.n * 100).toFixed(1), w2 = (p.l2 / p.n * 100).toFixed(1);
    html += `<p class="lean-h">On the ${DATA.nsplit} statements where the groups took opposite sides, they voted on ${p.n}:</p>
      <div class="lean" aria-hidden="true"><i class="l1" style="width:${w1}%"></i><i class="l2" style="width:${w2}%"></i></div>
      <div class="lean-n"><span><i class="dot g1"></i>Like Group 1: <b>${p.l1}</b></span><span>Like Group 2: <b>${p.l2}</b><i class="dot g2"></i></span></div>`;
    let note;
    if (p.share >= .65) note = `Mostly in line with the rest of ${NAME[me]}.`;
    else if (p.share >= .5) note = `They sit near the border, voting partly like each group.`;
    else note = `On these they voted more like ${NAME[other]}, but they were placed in ${NAME[me]} using all of their votes. With only ${p.n} of these statements to go on, they sit right at the border.`;
    html += `<p class="note">${note}</p>`;
    const ex = [];
    const mine = me ? [p.e2, p.v2, 1] : [p.e1, p.v1, 0], theirs = me ? [p.e1, p.v1, 0] : [p.e2, p.v2, 1];
    if (mine[0] >= 0) ex.push(mine); if (theirs[0] >= 0) ex.push(theirs);
    html += ex.slice(0, 2).map(([id, v, s]) => example(id, v, s)).join('');
  }
  card.innerHTML = html;
  ring.setAttribute('cx', p.x); ring.setAttribute('cy', p.y); ring.setAttribute('opacity', 1);
  card.classList.add('on');
  if (window.matchMedia('(max-width: 900px)').matches) return;
  const box = svg.getBoundingClientRect(), cb = mapCardEl.getBoundingClientRect();
  const px = box.left - cb.left + p.x / MW * box.width, py = box.top - cb.top + p.y / MH * box.height;
  const w = card.offsetWidth, h = card.offsetHeight;
  const left = px > cb.width / 2 ? px - w - 26 : px + 26;
  // never above the map card: on this short map a tall card hangs below it instead
  const top = Math.max(10, Math.min(py - h / 2, cb.height - h - 10));
  card.style.left = left + 'px'; card.style.top = top + 'px';
}
hidePerson = function () { card.classList.remove('on'); ring.setAttribute('opacity', 0); current = -1; };
function nearest(evt) {
  const pt = svg.createSVGPoint(); pt.x = evt.clientX; pt.y = evt.clientY;
  const m = svg.getScreenCTM(); if (!m) return -1;
  const q = pt.matrixTransform(m.inverse());
  let best = -1, bd = Infinity;
  people.forEach((p, i) => { const d = (p.x - q.x) ** 2 + (p.y - q.y) ** 2; if (d < bd) { bd = d; best = i; } });
  const lim = (MW / (svg.clientWidth || MW)) * 22;
  return bd <= lim * lim ? best : -1;
}
svg.addEventListener('pointermove', e => { if (e.pointerType !== 'mouse') return; const i = nearest(e); if (i < 0) hidePerson(); else showPerson(i); });
svg.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse') hidePerson(); });
svg.addEventListener('click', e => { const i = nearest(e); if (i >= 0) showPerson(i); });
const candidates = people.filter(p => p.n >= 3).map(p => p.i);
document.getElementById('someone').addEventListener('click', () => {
  let i; do { i = candidates[Math.floor(Math.random() * candidates.length)]; } while (i === current && candidates.length > 1);
  placeAll(true); dots.forEach((d, j) => { d.style.opacity = 1; d.style.fill = finalFill(people[j]); });
  showPerson(i);
});

/* ================= where they agree, and the priority vote (every figure comes from the frozen export and the
   priority-vote count, through the content-data block that inject_kooyong.py fills) ================= */
const CONTENT = JSON.parse(document.getElementById('content-data').textContent);
function dumbbell(a, b, na, nb) {
  const small = n => n && n < 20 ? `<span class="nn">(${n} voted)</span>` : '';
  const wrap = document.createElement('div');
  const W = 600, H = 58, L = 16, R = W - 16, Y = 22, x = v => L + (R - L) * v / 100;
  const s = el('svg', { viewBox: `0 0 ${W} ${H}`, class: 'dumb', role: 'img', 'aria-label': `Group 1: ${a}% agree. Group 2: ${b}% agree.` });
  el('line', { x1: L, x2: R, y1: Y, y2: Y, class: 'trk', 'stroke-width': 6, 'stroke-linecap': 'round' }, s);
  [[0, 'start'], [100, 'end']].forEach(([v, anc]) => { const t = el('text', { x: x(v), y: H - 2, 'font-size': 15, class: 'tick', 'text-anchor': anc }, s); t.textContent = v + '%'; });
  el('line', { x1: x(Math.min(a, b)), x2: x(Math.max(a, b)), y1: Y, y2: Y, class: 'rng', 'stroke-width': 6 }, s);
  if (a === b) {
    const cx = x(a), r = 14;
    el('path', { d: `M${cx},${Y - r} A${r},${r} 0 0 0 ${cx},${Y + r} Z`, fill: 'var(--g1)' }, s);
    el('path', { d: `M${cx},${Y - r} A${r},${r} 0 0 1 ${cx},${Y + r} Z`, fill: 'var(--g2)' }, s);
    el('circle', { cx, cy: Y, r, fill: 'none', class: 'ring', 'stroke-width': 3 }, s);
  } else {
    [[b, 'var(--g2)'], [a, 'var(--g1)']].forEach(([v, c]) => el('circle', { cx: x(v), cy: Y, r: 14, fill: c, class: 'ring', 'stroke-width': 3 }, s));
  }
  wrap.appendChild(s);
  const vals = document.createElement('div'); vals.className = 'vals';
  vals.innerHTML = a === b
    ? `<span><i class="dot g1"></i><i class="dot g2" style="margin-left:-4px"></i><b>${a}%</b> of both groups agree</span>`
    : `<span><i class="dot g1"></i>Group 1 <b>${a}%</b>${small(na)}</span><span><i class="dot g2"></i>Group 2 <b>${b}%</b>${small(nb)}</span>`;
  wrap.appendChild(vals);
  return wrap;
}
/* each statement: [id, text, Group 1 %, Group 2 %, Group 1 voters, Group 2 voters] */
const pairsRoot = document.getElementById('pairs');
CONTENT.pairs.forEach(p => {
  const d = document.createElement('article'); d.className = 'pair';
  d.innerHTML = `<div class="topic"><h3></h3><span class="n">Statements ${p.split[0]} and ${p.agree[0]}</span></div>
    <div class="half split-half"><span class="pill">They disagree on</span><q></q></div>
    <div class="half agree"><span class="pill">But both back</span><q></q></div>`;
  d.querySelector('h3').textContent = p.topic;
  const [qs, qa] = d.querySelectorAll('q'); qs.textContent = p.split[1]; qa.textContent = p.agree[1];
  d.querySelector('.split-half').appendChild(dumbbell(p.split[2], p.split[3], p.split[4], p.split[5]));
  d.querySelector('.agree').appendChild(dumbbell(p.agree[2], p.agree[3], p.agree[4], p.agree[5]));
  pairsRoot.appendChild(d);
});
/* all statements at least 7 in 10 of both groups agreed with (10+ voters in each), highest shared support first */
const allRoot = document.getElementById('all');
CONTENT.shared.forEach(([id, t, a, b, na, nb]) => {
  const li = document.createElement('li');
  const sm = n => n < 20 ? ` <span class="nn">(${n} voted)</span>` : '';
  li.innerHTML = `<q></q><div class="vals"><span><i class="dot g1"></i>Group 1 <b>${a}%</b>${sm(na)}</span><span><i class="dot g2"></i>Group 2 <b>${b}%</b>${sm(nb)}</span><span>Statement ${id}</span></div>`;
  li.querySelector('q').textContent = t;
  allRoot.appendChild(li);
});
/* priorities: equal net votes would share a place (q.rank comes from the count) */
const QV = CONTENT.qv, VOTERS = CONTENT.voters;
const TOPNET = QV.length ? QV[0].net : 1;  // the top change's bar is full width; the others compare with it
const pg = document.getElementById('prio'), rest = document.getElementById('rest');
QV.forEach((q, i) => {
  if (i < 6) {
    const c = document.createElement('article'); c.className = 'pcard';
    c.innerHTML = `<span class="rank" aria-hidden="true">${q.rank}</span><div class="tt"><p class="t"></p></div><div class="tally"><p class="big">+${q.net}<span>net votes</span></p><div class="tbar" aria-hidden="true"><i style="width:${(q.net / TOPNET * 100).toFixed(1)}%"></i></div></div><div class="pstats"><span>${q.y} of ${VOTERS} backed it, ${q.n} opposed</span></div>`;
    c.querySelector('.t').textContent = q.t;
    const ec = document.createElement('div'); ec.className = 'echo';
    if (q.e) {
      ec.innerHTML = `<p class="el">In the conversation, statement ${q.e[0]}</p><q></q><div class="vals"><span><i class="dot g1"></i>Group 1 <b>${q.e[2]}%</b></span><span><i class="dot g2"></i>Group 2 <b>${q.e[3]}%</b></span></div>${q.en ? '<p class="en"></p>' : ''}`;
      ec.querySelector('q').textContent = q.e[1];
      if (q.en) ec.querySelector('.en').textContent = q.en;
    } else {
      ec.innerHTML = '<p class="en">No statement in the conversation matched this one closely.</p>';
    }
    c.appendChild(ec);
    pg.appendChild(c);
  } else {
    const li = document.createElement('li');
    li.innerHTML = `<span class="r">${q.rank}</span><span class="t"></span><span class="s"><b class="rnet">${q.net >= 0 ? '+' : '−'}${Math.abs(q.net)}</b><span class="rs">${q.y} of ${VOTERS} backed it</span></span>`;
    li.querySelector('.t').textContent = q.t; rest.appendChild(li);
  }
});
</script>
