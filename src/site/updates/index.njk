---
layout: layouts/_base.njk
title: "Updates"
description: "Blog posts, announcements, papers, Salons and podcast episodes from RadicalxChange since 2018."
---
{% import "components/menu.njk" as menu %}
{% import "components/footer.njk" as footer %}
{{ menu.render() }}
<main id="main">

<section class="page-hero"><div class="wrap">
<div><h1>Read and watch.</h1><p class="lede">Everything the Foundation has published since 2018: blog, announcements, papers, Salons and the podcast. Filter by kind, or scroll by year.</p></div>
<div class="aside">Subscribe to the <a href="#newsletter">newsletter</a> for one email a month. Podcast on <a href="https://open.spotify.com/show/1Dra7JqDbgw1eXJRk7Pq5e">Spotify</a> and <a href="https://www.youtube.com/channel/UCxRk8v1Wcxa1TIKTvqrtSOw">YouTube</a>; Salons and video on YouTube.</div>
</div></section>
<section class="section" id="archive"><div class="wrap">
<div class="section-head"><div><h2>Everything, by year</h2><p>Filter by kind. Podcast episodes link to our YouTube channel; the whole show is also on <a href="https://open.spotify.com/show/1Dra7JqDbgw1eXJRk7Pq5e">Spotify</a>.</p></div></div>
<div class="filters" role="group" aria-label="Filter updates">
<button type="button" data-filter="all" aria-pressed="true">All</button>
<button type="button" data-filter="blog" aria-pressed="false">Blog</button>
<button type="button" data-filter="announcement" aria-pressed="false">Announcements</button>
<button type="button" data-filter="paper" aria-pressed="false">Papers</button>
<button type="button" data-filter="salon" aria-pressed="false">Salons</button>
<button type="button" data-filter="podcast" aria-pressed="false">Podcast</button>
<button type="button" data-filter="video" aria-pressed="false">Video</button>
</div>
<div id="archive-list">
{% for group in collections.archiveByYear %}
<p class="year">{{ group.year }}</p>
<ul class="list">
{% for item in group.items %}{% if item.kind != "other" %}
<li data-kind="{{ item.kind }}"><a href="{{ item.url }}">{{ (item.postHeader or item.title) | replace("⿻ ", "") }}</a><span class="meta"><i{% if item.kind != "blog" %} class="b"{% endif %}>{{ {"blog":"Blog","announcement":"Announcement","paper":"Paper","salon":"Salon","podcast":"Podcast","video":"Video"}[item.kind] }}</i>{% if item.postAuthor and item.postAuthor != "RxC Team" %} {{ item.postAuthor }},{% endif %}{% if item.publisher %} {{ item.publisher }},{% endif %} {{ item.readableDate }}</span></li>
{% endif %}{% endfor %}
</ul>
{% endfor %}
</div>
</div></section>
</main>
{{ footer.render() }}
<script>
(function(){var bs=document.querySelectorAll('.filters button'),list=document.getElementById('archive-list');
function apply(f){bs.forEach(function(x){x.setAttribute('aria-pressed',String(x.dataset.filter===f));});
list.querySelectorAll('li').forEach(function(li){li.hidden=!(f==='all'||li.dataset.kind===f);});
list.querySelectorAll('.year').forEach(function(y){var u=y.nextElementSibling;y.hidden=!u||!Array.prototype.some.call(u.children,function(li){return !li.hidden;});});
if(f!=='all'){history.replaceState(null,'','#'+f);}else{history.replaceState(null,'',location.pathname);}}
bs.forEach(function(b){b.addEventListener('click',function(){apply(b.dataset.filter);});});
var h=location.hash.replace('#','');if(h&&document.querySelector('.filters [data-filter="'+h+'"]'))apply(h);})();
</script>