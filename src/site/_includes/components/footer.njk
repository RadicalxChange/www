{#
  Site footer. Called as {{ footer.render() }} by every page.
#}
{% macro render() %}
<footer>
  <div class="wrap">
    <div class="cols">
      <div>
        <h4 id="newsletter">Stay in the loop</h4>
        <p>One email a month. No spam, no resale of your data.</p>
        <form class="signup" action="https://radicalxchange.us19.list-manage.com/subscribe/post?u=43120a1fed800e11539c2e78d&amp;id=2e47820582" method="post" name="mc-embedded-subscribe-form" target="_blank" novalidate onsubmit="if(window.fathom){window.fathom.trackGoal('BZOTPUXU', 0);}">
          <label for="mce-EMAIL" class="skip">Email address</label>
          <input id="mce-EMAIL" type="email" name="EMAIL" placeholder="you@email.com" required>
          <button class="btn" type="submit" name="subscribe">Subscribe</button>
        </form>
        <a class="btn donate" href="https://www.paypal.com/cgi-bin/webscr?cmd=_s-xclick&amp;hosted_button_id=Q66E4MUK6K6KQ">Donate</a> <a class="more" href="https://commerce.coinbase.com/checkout/a68957cd-9253-4b60-ac6a-2b0d3f472647" style="margin-left:.9rem;color:rgba(255,255,255,.85)">or give in crypto</a>
      </div>
      <div>
        <h4>Site</h4>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/tools/">Plural tools</a></li>
          <li><a href="/projects/">Projects and case studies</a></li>
          <li><a href="/community/">Community</a></li>
          <li><a href="/updates/">Updates</a></li>
          <li><a href="/wiki/">Library</a></li>
          <li><a href="/search/">Search</a></li>
        </ul>
      </div>
      <div>
        <h4>Elsewhere</h4>
        <ul>
          <li><a href="https://www.youtube.com/channel/UCxRk8v1Wcxa1TIKTvqrtSOw">YouTube</a></li>
          <li><a href="https://twitter.com/RadxChange">Twitter</a></li>
          <li><a href="https://www.linkedin.com/company/radicalxchange">LinkedIn</a></li>
          <li><a href="https://www.instagram.com/radxchange/">Instagram</a></li>
          <li><a href="mailto:info@radicalxchange.org">info@radicalxchange.org</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© 2026 RadicalxChange Foundation Ltd., a 501(c)(3) nonprofit. We do not support or oppose candidates for public office or political parties.</span>
      <ul><li><a href="/privacy-policy/">Privacy</a></li><li><a href="/community/code-of-conduct/">Code of conduct</a></li></ul>
    </div>
  </div>
</footer>
<script src="/assets/field.js" defer></script>
{% endmacro %}
