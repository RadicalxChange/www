{#
  Site header. Called as {{ menu.render() }} by every page. Replaces the previous slide-out menu.
#}
{% macro render() %}
<a class="skip" href="#main">Skip to content</a>
<header class="bar">
  <div class="wrap">
    <a class="mark" href="/"><span class="glyph" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="12" height="12"/><rect x="9" y="9" width="12" height="12"/></svg></span>RadicalxChange</a>
    <nav class="primary" aria-label="Primary">
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/tools/">Plural tools</a></li>
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/community/">Community</a></li>
        <li><a href="/updates/">Updates</a></li>
        <li><a href="/wiki/">Library</a></li>
        <li><a href="/search/" aria-label="Search" title="Search (Cmd+K)"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="display:block"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></a></li>
        <li><a class="btn primary" href="/community/#call">Join the monthly call</a></li>
      </ul>
    </nav>
    <details class="menu">
      <summary>Menu</summary>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/tools/">Plural tools</a></li>
        <li><a href="/projects/">Projects and case studies</a></li>
        <li><a href="/community/">Community</a></li>
        <li><a href="/updates/">Updates</a></li>
        <li><a href="/wiki/">Library</a></li>
        <li><a href="/search/">Search</a></li>
        <li><a class="btn primary" href="/community/#call">Join the monthly call</a></li>
      </ul>
    </details>
  </div>
</header>
<script>
  (function(){var p=location.pathname;document.querySelectorAll('nav.primary a, .menu a').forEach(function(a){var h=a.getAttribute('href');
  if(h&&h!=='/'&&!a.classList.contains('btn')&&p.indexOf(h)===0){a.classList.add('nav-current');a.setAttribute('aria-current','page');}});})();
</script>
{% endmacro %}
