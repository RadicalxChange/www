<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <!-- prettier-ignore -->
    {% block fontPreloads %}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap" rel="stylesheet" />
    <!-- prettier-ignore -->
    {% endblock %}
    <!-- prettier-ignore -->
    {% block mathStyles %}
    <link
      rel="stylesheet"
      href="https://unpkg.com/katex@latest/dist/katex.min.css"
    />
    <!-- prettier-ignore -->
    {% endblock %}
    <!-- prettier-ignore -->
    {% block metaTags %}
    <meta
      name="description"
      content="{{ description | default(metadata.defaultDescription) }}"
    />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="{{ ogType | default('website') }}" />
    <meta
      property="og:title"
      content="{{ title | default('RadicalxChange') }}"
    />
    <meta property="og:site_name" content="RadicalxChange" />
    <meta property="og:url" content="{{ metadata.url + page.url }}" />
    <meta
      property="og:image"
      content="{{ metadata.url }}/assets/og-image.png"
    />
    <meta
      property="og:image:secure_url"
      content="{{ metadata.url }}/assets/og-image.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:description"
      content="{{ description | default(metadata.defaultDescription) }}"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="{{ title | default('RadicalxChange') }}"
    />
    <meta name="twitter:site" content="@radxchange" />
    <meta
      name="twitter:image"
      content="{{ metadata.url }}/assets/og-image.png"
    />
    <meta name="twitter:creator" content="@radxchange" />
    <meta
      name="twitter:description"
      content="{{ description | default(metadata.defaultDescription) }}"
    />
    <!-- prettier-ignore -->
    {% endblock %}

    <!-- prettier-ignore -->
    {% block headScripts %}
    <script src="https://unpkg.com/@ungap/custom-elements"></script>
    <script
      src="https://rabbit.radicalxchange.org/script.js"
      site="SQHLZNME"
      included-domains="www.radicalxchange.org"
      defer
    ></script>
    <!-- prettier-ignore -->
    {% endblock %}
    <!-- prettier-ignore -->
    {% block styles %}
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/assets/rxc.css" />
    <!-- prettier-ignore -->
    {% endblock %}
    <!-- prettier-ignore -->
    {% block otherHead %}
    <!-- prettier-ignore -->
    {% endblock %}
    <title>
      {{ title + " - RadicalxChange" if title else "RadicalxChange"}}
    </title>
  </head>
  <!-- prettier-ignore -->
  <body class="{{ bodyBg }}">
    <!-- prettier-ignore -->
    {% block body %}
    {{ content | safe }}
    <!-- prettier-ignore -->
    {% endblock %}
    <!-- Web Components -->
    <script src="/js/a-replace.js"></script>
    <!-- Global search shortcut -->
    <script>
      document.addEventListener('keydown', function(e) {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          window.location.href = '/search';
        }
      });
    </script>
  </body>
</html>
