/* ================= priorities ================= */
const QV = [{"rank":1,"t":"Plan migration together with housing and infrastructure, so new arrivals are matched by homes and services.","y":50,"n":2,"net":166,"e":[9,"I'd trust the system more if housing, roads, schools and hospitals kept pace with how many people move into our area.",77,85,85,60,27,13]},{"rank":2,"t":"Create a dedicated visa pathway for aged care, disability and other care workers.","y":46,"n":3,"net":151,"e":[24,"Australia needs more than top professionals. We rely on aged care and disability workers from overseas, so there should be a real visa pathway for them even though the pay is low.",89,85,33,63,27,15],"en":"The groups split on this one in the conversation."},{"rank":3,"t":"Ban employers caught exploiting visa workers from sponsoring anyone again.","y":50,"n":2,"net":144},{"rank":4,"t":"Set a ten-year population and migration plan, with a published target range, reported to Parliament every year and independently reviewed.","y":49,"n":2,"net":136,"e":[0,"I'd trust migration more if it was planned 10 to 15 years ahead for what the country needs, not around the three-year election cycle.",76,75,38,62,28,13],"en":"Group 3 was divided on this one."},{"rank":5,"t":"Remove people with no right to stay more quickly.","y":42,"n":2,"net":119,"e":[200,"We need a method of removing people who have failed asylum claims and appeals that failed. There’s thousands of them.",32,100,100,19,3,2],"en":"Few people in Groups 2 and 3 voted on this one."},{"rank":6,"t":"Fund universities properly so they rely less on international student fees.","y":42,"n":8,"net":102,"e":[35,"The government should fund universities properly so they don't have to rely on international students to stay afloat.",74,78,73,62,27,15]},{"rank":7,"t":"Let sponsored workers change employers without losing their visa.","y":45,"n":6,"net":93,"e":[18,"No one should have to choose between staying in a bad job and losing their visa. Workers need to be able to walk away.",77,67,7,62,27,14],"en":"The groups split on this one in the conversation."},{"rank":8,"t":"Tell people the rules when they apply, and keep those rules for the life of their visa.","y":40,"n":4,"net":75,"e":[4,"People should be told the rules when they apply, and those rules should hold for the life of their visa. When rules change without warning, the people we need most choose another country.",62,59,29,68,27,14],"en":"The groups split on this one in the conversation."},{"rank":9,"t":"Publish a target to reduce the share of the population on temporary visas.","y":39,"n":5,"net":74},{"rank":10,"t":"Limit time on temporary visas to a maximum of about eight years.","y":35,"n":6,"net":71},{"rank":11,"t":"Replace the permanent parent visa with a long-stay family visitor visa, letting parents and grandparents spend extended periods with family here.","y":38,"n":8,"net":65},{"rank":12,"t":"Spend more on English classes and settlement support, to help newcomers settle in faster.","y":36,"n":9,"net":64,"e":[27,"If we expect newcomers to learn English, classes and settlement support should be funded for everyone, not just permanent arrivals.",75,36,7,64,25,15],"en":"The groups split on this one in the conversation."}];
const VOTERS = 54;
const TOPNET = QV[0].net;  // the top change's bar is full width; the others compare with it
const pg = document.getElementById('prio'), rest = document.getElementById('rest');
QV.forEach((q, i) => {
  if (i < 6) {
    const c = document.createElement('article'); c.className = 'pcard';
    c.innerHTML = `<span class="rank" aria-hidden="true">${q.rank}</span><div class="tt"><p class="t"></p></div><div class="tally"><p class="big">+${q.net}<span>net votes</span></p><div class="tbar" aria-hidden="true"><i style="width:${(q.net / TOPNET * 100).toFixed(1)}%"></i></div></div><div class="pstats"><span>${q.y} of ${VOTERS} backed it, ${q.n} opposed</span></div>`;
    c.querySelector('.t').textContent = q.t;
    const ec = document.createElement('div'); ec.className = 'echo';
    if (q.e) {
      // the statement written on the same idea, with all three groups' shares; (N voted) where under 20 voted
      const sm = k => k < 20 ? ` <span class="nn">(${k} voted)</span>` : '';
      ec.innerHTML = `<p class="el">In the conversation, statement ${q.e[0]}</p><q></q><div class="vals">` +
        [0, 1, 2].map(g => `<span><i class="dot g${g + 1}"></i>Group ${g + 1} <b>${q.e[2 + g]}%</b>${sm(q.e[5 + g])}</span>`).join('') +
        `</div>${q.en ? '<p class="en"></p>' : ''}`;
      ec.querySelector('q').textContent = q.e[1];
      if (q.en) ec.querySelector('.en').textContent = q.en;
    } else {
      ec.innerHTML = '<p class="en">No statement in the conversation matched this one closely.</p>';
    }
    c.appendChild(ec);
    pg.appendChild(c);
  } else {
    const li = document.createElement('li');
    li.innerHTML = `<span class="r">${q.rank}</span><span class="t"></span><span class="s"><b class="rnet">+${q.net}</b><span class="rs">${q.y} of ${VOTERS} backed it</span></span>`;
    li.querySelector('.t').textContent = q.t; rest.appendChild(li);
  }
});
</script>
