// one example per group the person voted like; a statement that is the example for two groups is shown once
function example([id, v, gs]) {
  const g = gs.slice().sort((a, b) => a - b);
  const who = g.map(x => NAME[x]).join(' and ');
  return `<div class="ex"><p class="exl">${g.map(x => `<i class="dot ${DOTS[x]}"></i>`).join('')}Like ${who}, they ${VERB[v]}:</p><q>${esc(DATA.texts[String(id)])}</q></div>`;
}
function showPerson(i) {
  if (i === current && card.classList.contains('on')) return;
  current = i; const p = people[i], me = p.g;
  const wrote = p.nc > 0 ? `, and wrote <b>${p.nc}</b> of their own` : '';
  let html = `<p class="pg"><i class="dot ${DOTS[me]}"></i>${FULL[me]}</p>
    <p class="pn">Voted on <b>${p.nv}</b> statements, agreeing with <b>${p.ar}%</b>${wrote}.</p>`;
  if (p.n === 0) {
    html += `<p class="note">They didn’t agree or disagree with any of the ${DATA.nsplit} statements where the groups took opposite sides, so they were placed using their other votes.</p>`;
  } else {
    html += `<p class="lean-h">On the ${DATA.nsplit} statements where the groups took opposite sides, they agreed or disagreed with ${p.n}:</p>
      <div class="likes">${[0, 1, 2].map(g => `<div class="lk"><span><i class="dot ${DOTS[g]}"></i>Like ${NAME[g]}</span><i class="bar" aria-hidden="true"><i style="width:${(100 * p.like[g] / p.n).toFixed(1)}%;background:${FILL[g]}"></i></i><b>${p.like[g]}</b></div>`).join('')}</div>`;
    const top = Math.max(...p.like);
    const note = p.like[me] === top ? `Mostly in line with the rest of ${NAME[me]}.`
      : `On these they voted most like ${NAME[p.like.indexOf(top)]}, but they were placed in ${NAME[me]} using all of their votes.`;
    html += `<p class="note">${note}</p>` + p.ex.map(example).join('');
  }
