// each group's share as a dot on a 0-100% track; equal shares share one dot, split into their groups' colours
function bells(v, n) {
  const small = k => k && k < 20 ? `<span class="nn">(${k} voted)</span>` : '';
  const wrap = document.createElement('div');
  const W = 600, H = 58, L = 16, R = W - 16, Y = 22, r = 14, x = t => L + (R - L) * t / 100;
  const s = el('svg', { viewBox: `0 0 ${W} ${H}`, class: 'dumb', role: 'img', 'aria-label': v.map((t, g) => `Group ${g + 1}: ${t}% agree.`).join(' ') });
  el('line', { x1: L, x2: R, y1: Y, y2: Y, class: 'trk', 'stroke-width': 6, 'stroke-linecap': 'round' }, s);
  [[0, 'start'], [100, 'end']].forEach(([t, anc]) => { const tx = el('text', { x: x(t), y: H - 2, 'font-size': 15, class: 'tick', 'text-anchor': anc }, s); tx.textContent = t + '%'; });
  el('line', { x1: x(Math.min(...v)), x2: x(Math.max(...v)), y1: Y, y2: Y, class: 'rng', 'stroke-width': 6 }, s);
  const at = (cx, a) => [cx + r * Math.sin(a), Y - r * Math.cos(a)];
  const byVal = new Map();
  v.forEach((t, g) => { if (!byVal.has(t)) byVal.set(t, []); byVal.get(t).push(g); });
  [...byVal.entries()].sort((a, b) => b[1][0] - a[1][0]).forEach(([t, gs]) => {   // Group 1's dot is drawn last, on top
    const cx = x(t);
    if (gs.length === 1) { el('circle', { cx, cy: Y, r, fill: FILL[gs[0]], class: 'ring', 'stroke-width': 3 }, s); return; }
    gs.forEach((g, j) => {
      const a0 = j / gs.length * 2 * Math.PI, a1 = (j + 1) / gs.length * 2 * Math.PI, [x0, y0] = at(cx, a0), [x1, y1] = at(cx, a1);
      el('path', { d: `M${cx},${Y} L${x0.toFixed(2)},${y0.toFixed(2)} A${r},${r} 0 ${a1 - a0 > Math.PI ? 1 : 0} 1 ${x1.toFixed(2)},${y1.toFixed(2)} Z`, fill: FILL[g] }, s);
    });
    el('circle', { cx, cy: Y, r, fill: 'none', class: 'ring', 'stroke-width': 3 }, s);
  });
  wrap.appendChild(s);
  const vals = document.createElement('div'); vals.className = 'vals';
  vals.innerHTML = byVal.size === 1
    ? `<span>${DOTS.map((d, g) => `<i class="dot ${d}"${g ? ' style="margin-left:-4px"' : ''}></i>`).join('')}<b>${v[0]}%</b> of all three groups agree</span>`
    : v.map((t, g) => `<span><i class="dot ${DOTS[g]}"></i>${NAME[g]} <b>${t}%</b>${small(n[g])}</span>`).join('');
  wrap.appendChild(vals);
  return wrap;
}

