const QV = [{"t":"Plan migration together with housing and infrastructure, so new arrivals are matched by homes and services.","y":45,"n":2,"net":158,"e":[9,"I'd trust the system more if housing, roads, schools and hospitals kept pace with how many people move into our area.",78,79]},{"t":"Set a ten-year population and migration plan, with a published target range, reported to Parliament every year and independently reviewed.","y":44,"n":2,"net":131,"e":[0,"I'd trust migration more if it was planned 10 to 15 years ahead for what the country needs, not around the three-year election cycle.",74,70]},{"t":"Create a dedicated visa pathway for aged care, disability and other care workers.","y":44,"n":1,"net":119,"e":[24,"Australia needs more than top professionals. We rely on aged care and disability workers from overseas, so there should be a real visa pathway for them even though the pay is low.",88,33],"en":"The groups split on this one in the conversation."},{"t":"Ban employers caught exploiting visa workers from sponsoring anyone again.","y":43,"n":2,"net":107},{"t":"Spend more on English classes and settlement support, to help newcomers settle in faster.","y":38,"n":4,"net":93,"e":[27,"If we expect newcomers to learn English, classes and settlement support should be funded for everyone, not just permanent arrivals.",51,13],"en":"The groups split on this one in the conversation."},{"t":"Remove people with no right to stay more quickly.","y":37,"n":6,"net":89},{"t":"Fund universities properly so they rely less on international student fees.","y":37,"n":4,"net":88},{"t":"Let sponsored workers change employers without losing their visa.","y":39,"n":6,"net":81},{"t":"Tell people the rules when they apply, and keep those rules for the life of their visa.","y":36,"n":8,"net":76},{"t":"Publish a target to reduce the share of the population on temporary visas.","y":31,"n":11,"net":52},{"t":"Replace the permanent parent visa with a long-stay family visitor visa, letting parents and grandparents spend extended periods with family here.","y":30,"n":13,"net":43},{"t":"Limit time on temporary visas to a maximum of about eight years.","y":28,"n":12,"net":34}];
const VOTERS = 49;
const TOPNET = QV.length ? QV[0].net : 1;  // the top change's bar is full width; the others compare with it
const pg = document.getElementById('prio'), rest = document.getElementById('rest');
QV.forEach((q, i) => {
  if (i < 6) {
    const c = document.createElement('article'); c.className = 'pcard';
    c.innerHTML = `<span class="rank" aria-hidden="true">${i + 1}</span><div class="tt"><p class="t"></p></div><div class="tally"><p class="big">+${q.net}<span>net votes</span></p><div class="tbar" aria-hidden="true"><i style="width:${(q.net / TOPNET * 100).toFixed(1)}%"></i></div></div><div class="pstats"><span>${q.y} of ${VOTERS} backed it, ${q.n} opposed</span></div>`;
    c.querySelector('.t').textContent = q.t;
    if (q.e) {
      const ec = document.createElement('div'); ec.className = 'echo';
      ec.innerHTML = `<p class="el">In the conversation, statement ${q.e[0]}</p><q></q><div class="vals"><span><i class="dot g1"></i>Group 1 <b>${q.e[2]}%</b></span><span><i class="dot g2"></i>Group 2 <b>${q.e[3]}%</b></span></div>${q.en ? '<p class="en"></p>' : ''}`;
      ec.querySelector('q').textContent = q.e[1];
      if (q.en) ec.querySelector('.en').textContent = q.en;
      c.appendChild(ec);
    } else {
      const ec = document.createElement('div'); ec.className = 'echo';
      ec.innerHTML = '<p class="en">No statement in the conversation matched this one closely.</p>';
      c.appendChild(ec);
    }
    pg.appendChild(c);
  } else {
    const li = document.createElement('li');
    li.innerHTML = `<span class="r">${i + 1}</span><span class="t"></span><span class="s"><b class="rnet">+${q.net}</b><span class="rs">${q.y} of ${VOTERS} backed it</span></span>`;
    li.querySelector('.t').textContent = q.t; rest.appendChild(li);
  }
});
