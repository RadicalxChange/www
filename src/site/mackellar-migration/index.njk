/* One hero standard on every migration results page (20 November 2026), from the shared file; this page
   sets only its headline fit. */
.hero-text{--h1-fit:10.6cqi}
@media (min-width:901px){
  .hero{display:grid;align-content:center;min-height:calc(100svh - 3.4rem)}
  .hero>.wrap{width:100%}
  .hero-grid{padding-top:clamp(16px,calc(100vh - 46rem),72px);padding-bottom:clamp(28px,calc(100vh - 44rem),80px);align-items:center}
