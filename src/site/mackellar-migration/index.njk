<script>
const NS = 'http://www.w3.org/2000/svg';
const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
function el(n, a, p) { const e = document.createElementNS(NS, n); for (const k in a) e.setAttribute(k, a[k]); if (p) p.appendChild(e); return e; }
function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
const DATA = JSON.parse(document.getElementById('page-data').textContent);
// the groups' names come from the generator (gen_mackellar.py), in one place
const NAME = ['Group 1', 'Group 2', 'Group 3'], FULL = DATA.names.map((n, g) => `Group ${g + 1}: ${n}`);

/* ================= map: one row along the main divide ================= */
const MW = 1000, PL = 24, PR = 24, TOP = 12, AXIS = 66;
let MH = 300, R = 6;
const svg = document.getElementById('map');
// Polis found these three groups itself, and they overlap on this line (Groups 1 and 2 most of all: a second
// question separates them, see the notes), so there is no boundary: DATA.cut is null and every dot may roll freely.
// Where a page has a boundary (a group split by the stance test), no dot rolls across it and no line is drawn.
const CUT = DATA.cut;
// each row: position, group, votes, agree %, statements written, candidates voted on, votes like each
// group, then each group's example statement and the person's vote on it
const people = DATA.people.map(([x, g, nv, ar, nc, n, l1, l2, l3, e1, v1, e2, v2, e3, v3], i) =>
  ({ i, g, nv, ar, nc, n, like: [l1, l2, l3], ex: [[e1, v1], [e2, v2], [e3, v3]], dv: x, x: 0, y: 0 }));
const COUNT = [0, 1, 2].map(g => people.filter(p => p.g === g).length);
const finalFill = p => `var(--g${p.g + 1})`;
const defs = el('defs', {}, svg);
const mk = el('marker', { id: 'arr', viewBox: '0 0 10 10', refX: 8, refY: 5, markerWidth: 7, markerHeight: 7, orient: 'auto-start-reverse' }, defs);
el('path', { d: 'M0,0 L10,5 L0,10 z', fill: 'var(--ink)' }, mk);
const axisLayer = el('g', {}, svg);
const labelLayer = el('g', { class: 'labels' }, svg);
const dotLayer = el('g', {}, svg);
const dots = people.map(p => el('circle', { r: R, cx: 0, cy: 0, class: 'pdot', fill: finalFill(p) }, dotLayer));
const ring = el('circle', { r: R + 5, fill: 'none', stroke: 'var(--ink)', 'stroke-width': 3, opacity: 0, 'pointer-events': 'none' }, svg);
let settled = false;
function layout() {
  const w = svg.clientWidth || MW, k = MW / w, narrow = w < 640;
  // the dot's radius in screen pixels, converted to map units: 9px (4.6px on phones) for 70 people, the fewest of
  // any seat (the pages with about a hundred people use 7px, the larger seats 5.2px), so the heaps still show
  R = (narrow ? 4.6 : 9) * k;
  const D = 2 * R + Math.max(1, .7 * k);
  const lo = PL + R, hi = MW - PR - R;
  // rounded heaps: each dot drops near its true place on the line and rolls a little to the lowest free
  // spot, paying for every step it moves sideways, so crowded stretches pile up like sand, not in columns
  // dots are dropped from left to right, so a dot may roll well to the left, into gaps among the dots
  // already placed, but only a little to the right; otherwise early dots run into empty space and later
  // ones wall up (against a boundary most of all). Narrow maps have fewer dot widths
  // across, so dots may roll further and pile less steeply there.
  const reach = narrow ? 6 : 3, ahead = 1.25, slope = narrow ? .6 : .9;
  const sx = CUT === null ? null : lo + CUT * (hi - lo), keep = R + 2.5 * k;  // no dot rolls across a boundary
  const placed = [];
  let top = 0;
  people.slice().sort((a, b) => a.dv - b.dv || a.i - b.i).forEach(p => {
    const from = CUT === null || p.dv < CUT ? lo : sx + keep, to = CUT !== null && p.dv < CUT ? sx - keep : hi;
    const tx = Math.min(to, Math.max(from, lo + p.dv * (hi - lo)));
    const local = placed.filter(q => Math.abs(q.x - tx) < (reach + 1.2) * D);
    let best = null;
    for (let s = -reach; s <= ahead + .001; s += .25) {
      const x = Math.min(to, Math.max(from, tx + s * D));
      const near = local.filter(q => Math.abs(q.x - x) < D);
      const cands = [0].concat(near.map(q => q.h + Math.sqrt(Math.max(0, D * D - (q.x - x) ** 2)))).sort((a, b) => a - b);
      const h = cands.find(c => near.every(q => (q.x - x) ** 2 + (q.h - c) ** 2 >= D * D - .5)) || 0;
      const score = h + slope * Math.abs(x - tx);
      if (!best || score < best.score) best = { x, h, score };
    }
    placed.push({ x: best.x, h: best.h, p });
    top = Math.max(top, best.h);
  });
  const fs = Math.max(17, 12.5 * k);
  const axisH = Math.max(AXIS, fs * 2.6);
  // each group's name (and count, on wide screens) over its own heap, all on one line above the tallest heap, as
  // on the other three-group results pages; where two names would touch, they are nudged apart
  const fsG = (narrow ? 12.5 : 17) * k, fsC = (narrow ? 11 : 14) * k;
  const grpH = narrow ? fsG * 1.25 : fsG * 1.25 + fsC * 1.15 + 4 * k;      // a group's name (and count)
  const bandH = top + 2 * R + 8 * k;                                       // the names share a line
  const headroom = Math.max(0, bandH + grpH - top - 2 * R);
  MH = Math.ceil(TOP + top + 2 * R + headroom + axisH);
  svg.setAttribute('viewBox', `0 0 ${MW} ${MH}`);
  const base = MH - axisH;
  placed.forEach(({ x, h, p }) => { p.x = x; p.y = base - R - h; });
  while (axisLayer.firstChild) axisLayer.removeChild(axisLayer.firstChild);
  const y0 = base + 8;
  el('line', { x1: PL, x2: MW - PR, y1: y0, y2: y0, class: 'axis', 'marker-start': 'url(#arr)', 'marker-end': 'url(#arr)' }, axisLayer);
  const lab = (txt, attrs) => { const t = el('text', Object.assign({ class: 'axis-label' }, attrs), axisLayer); t.style.fontSize = fs + 'px'; t.textContent = txt; return t; };
  const lt = lab(DATA.names[0], { x: PL, y: y0 + fs * 1.6 });
  const rt = lab(DATA.names[2], { x: MW - PR, y: y0 + fs * 1.6, 'text-anchor': 'end' });
  const room = MW - PL - PR - 30, used = lt.getBBox().width + rt.getBBox().width;  // never let the two labels touch
  if (used > room) [lt, rt].forEach(t => t.style.fontSize = (fs * room / used).toFixed(1) + 'px');
  // the labels: centred on each heap (the 10th to 90th percentile of its dots), nudged apart left to right and
  // then back, and kept on the map
  while (labelLayer.firstChild) labelLayer.removeChild(labelLayer.firstChild);
  const text = (cls, x, y, size, str, g, anchor = 'middle') => { const t = el('text', { class: cls, x: x.toFixed(1), y: y.toFixed(1), 'text-anchor': anchor }, g); t.style.fontSize = size + 'px'; t.textContent = str; return t; };
  const yName = base - bandH - (narrow ? 0 : fsC * 1.15 + 4 * k), sep = 16 * k;
  // each label (as on the Curtin page): the group's name with its dot, and "Group k · N people" under it; if the names
  // can't fit side by side even when nudged apart, the labels use "Group k" with "N people" under it; phones show
  // "Group k" only
  const place = mode => {
    while (labelLayer.firstChild) labelLayer.removeChild(labelLayer.firstChild);
    const labels = [0, 1, 2].map(gi => {
      const xs = placed.filter(q => q.p.g === gi).map(q => q.x).sort((a, b) => a - b);
      const g = el('g', { class: 'grp' }, labelLayer);
      el('title', {}, g).textContent = `${FULL[gi]}: ${xs.length} people`;
      const t = text('grp-name', 0, yName, fsG, mode === 'full' ? DATA.names[gi] : NAME[gi], g, 'start');
      const c = mode === 'narrow' ? null : text('st-count', 0, base - bandH, fsC, mode === 'full' ? `${NAME[gi]} · ${xs.length} people` : `${xs.length} people`, g, 'start');
      const dr = fsG * .3, gap = 6 * k, wd = t.getComputedTextLength(), wc = c ? c.getComputedTextLength() : 0;
      const nb = 2 * dr + gap + wd, total = Math.max(nb, wc), cx = (xs[Math.floor(xs.length * .1)] + xs[Math.floor(xs.length * .9)]) / 2;
      return { gi, g, t, c, dr, gap, wd, wc, nb, total, left: cx - total / 2 };
    });
    for (let j = 1; j < 3; j++) labels[j].left = Math.max(labels[j].left, labels[j - 1].left + labels[j - 1].total + sep);
    labels[2].left = Math.min(labels[2].left, MW - PR - labels[2].total);
    for (let j = 1; j >= 0; j--) labels[j].left = Math.min(labels[j].left, labels[j + 1].left - sep - labels[j].total);
    labels[0].left = Math.max(labels[0].left, PL);
    labels.forEach(L => {
      const x0 = L.left + (L.total - L.nb) / 2, tx = x0 + 2 * L.dr + L.gap;
      L.t.setAttribute('x', tx.toFixed(1));
      el('circle', { cx: (x0 + L.dr).toFixed(1), cy: (yName - fsG * .34).toFixed(1), r: L.dr.toFixed(1), fill: `var(--g${L.gi + 1})` }, L.g);
      if (L.c) L.c.setAttribute('x', (L.left + (L.total - L.wc) / 2).toFixed(1));
    });
    return labels.every((L, j) => (j === 0 ? L.left >= PL - .5 : L.left >= labels[j - 1].left + labels[j - 1].total + sep - .5)) && labels[2].left + labels[2].total <= MW - PR + .5;
  };
  if (narrow) place('narrow'); else if (!place('full')) place('short');
  dots.forEach(d => d.setAttribute('r', R.toFixed(2)));
  ring.setAttribute('r', (R + 4 * k).toFixed(1));
  ring.setAttribute('stroke-width', (2 * k).toFixed(1));
  if (settled) { dots.forEach((d, i) => { d.style.transition = 'none'; d.style.transform = `translate(${people[i].x}px, ${people[i].y}px)`; }); svg.getBoundingClientRect(); dots.forEach(d => d.style.transition = ''); }
  hidePerson && hidePerson();
}
function placeAll(final) {
  dots.forEach((d, i) => {
    const p = people[i];
    const x = final ? p.x : MW / 2 + (Math.sin(i * 12.9898) * 43758.5453 % 1) * 200;
    const y = final ? p.y : (MH - AXIS) / 2 + (Math.sin(i * 78.233) * 12345.678 % 1) * 50;
    d.style.transform = `translate(${x}px, ${y}px)`;
  });
  if (final) settled = true;
}
var hidePerson = null;
layout();
let lastW = svg.clientWidth;
window.addEventListener('resize', () => { clearTimeout(window.__rz); window.__rz = setTimeout(() => { if (svg.clientWidth !== lastW) { lastW = svg.clientWidth; layout(); } }, 150); });
if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { lastW = svg.clientWidth; layout(); });
if (reduce || !('IntersectionObserver' in window)) { placeAll(true); }
else {
  dots.forEach(d => { d.style.transition = 'none'; d.style.opacity = .35; d.style.fill = 'var(--muted)'; });
  placeAll(false);
  svg.getBoundingClientRect();
  const io = new IntersectionObserver(es => { if (!es[0].isIntersecting) return; io.disconnect();
    dots.forEach((d, i) => { d.style.transition = ''; d.style.transitionDelay = ((i * 37 % 100) / 220).toFixed(2) + 's'; });
    requestAnimationFrame(() => placeAll(true));
    setTimeout(() => dots.forEach((d, i) => { d.style.transitionDelay = '0s'; d.style.opacity = 1; d.style.fill = finalFill(people[i]); }), 1500);
  }, { threshold: .35 });
  io.observe(svg);
}

// person card
const card = document.getElementById('person');
const mapCard = document.getElementById('map-card');
let current = -1;
const VERB = { a: 'agreed', d: 'disagreed' };
const dotFor = g => `<i class="dot g${g + 1}"></i>`;
function showPerson(i) {
  if (i === current && card.classList.contains('on')) return;
  current = i; const p = people[i], me = p.g;
  const wrote = p.nc > 0 ? `, and wrote <b>${p.nc}</b> of their own` : '';
  let html = `<p class="pg">${dotFor(me)}${FULL[me]}</p>
    <p class="pn">Voted on <b>${p.nv}</b> statements, agreeing with <b>${p.ar}%</b>${wrote}.</p>`;
  if (p.n === 0) {
    html += `<p class="note">They didn’t agree or disagree with any of the ${DATA.nsplit} statements where the groups took opposite sides, so they were placed using their other votes.</p>`;
  } else {
    // how often they voted like each group: a vote can match two groups, so each row is out of all their votes on these
    html += `<p class="lean-h">On the ${DATA.nsplit} statements that split the groups, they agreed or disagreed with ${p.n}:</p>
      <div class="lean3">` + [0, 1, 2].map(g => `<span class="ln">${dotFor(g)}Like ${NAME[g]}</span><span class="lb" aria-hidden="true"><i style="width:${(p.like[g] / p.n * 100).toFixed(1)}%;background:var(--g${g + 1})"></i></span><b>${p.like[g]}</b>`).join('') + `</div>`;
    const near = [0, 1, 2].filter(g => g !== me).sort((a, b) => p.like[b] - p.like[a] || a - b)[0];
    let note;
    if (p.like[me] / p.n >= .65) note = `Mostly in line with the rest of ${NAME[me]}.`;
    else if (p.like[near] > p.like[me]) note = `On these they voted more like ${NAME[near]}, but all of their votes place them in ${NAME[me]}.`;
    else note = `They voted partly like the other groups.`;
    html += `<p class="note">${note}</p>`;
    // one example for each group they voted like, their own group's first; a statement that fits two groups is shown once
    const ex = [];
    [me].concat([0, 1, 2].filter(g => g !== me)).forEach(g => {
      const [id, v] = p.ex[g]; if (id < 0) return;
      const hit = ex.find(e => e.id === id); if (hit) hit.gs.push(g); else ex.push({ id, v, gs: [g] });
    });
    html += ex.map(e => { const gs = e.gs.slice().sort(); return `<div class="ex"><p class="exl">${gs.map(dotFor).join('')}Like ${gs.map(g => NAME[g]).join(' and ')}, they ${VERB[e.v]}:</p><q>${esc(DATA.texts[String(e.id)])}</q></div>`; }).join('');
  }
  card.innerHTML = html;
  ring.setAttribute('cx', p.x); ring.setAttribute('cy', p.y); ring.setAttribute('opacity', 1);
  card.classList.add('on');
  if (window.matchMedia('(max-width: 900px)').matches) return;
  const box = svg.getBoundingClientRect(), cb = mapCard.getBoundingClientRect();
  const px = box.left - cb.left + p.x / MW * box.width, py = box.top - cb.top + p.y / MH * box.height;
  const w = card.offsetWidth, h = card.offsetHeight;
  const left = px > cb.width / 2 ? px - w - 26 : px + 26;
  // centred on the dot, inside the map card where it fits; a card taller than the map stays on screen instead
  let top = Math.min(Math.max(py - h / 2, 10), cb.height - h - 10);
  if (h > cb.height - 20) top = Math.max(10 - cb.top, Math.min(py - h / 2, innerHeight - cb.top - h - 10));
  card.style.left = left + 'px'; card.style.top = top + 'px';
}
hidePerson = function () { card.classList.remove('on'); ring.setAttribute('opacity', 0); current = -1; };
function nearest(evt) {
  const pt = svg.createSVGPoint(); pt.x = evt.clientX; pt.y = evt.clientY;
  const m = svg.getScreenCTM(); if (!m) return -1;
  const q = pt.matrixTransform(m.inverse());
  let best = -1, bd = Infinity;
  people.forEach((p, i) => { const d = (p.x - q.x) ** 2 + (p.y - q.y) ** 2; if (d < bd) { bd = d; best = i; } });
  const lim = (MW / (svg.clientWidth || MW)) * 22;
  return bd <= lim * lim ? best : -1;
}
svg.addEventListener('pointermove', e => { if (e.pointerType !== 'mouse') return; const i = nearest(e); if (i < 0) hidePerson(); else showPerson(i); });
svg.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse') hidePerson(); });
svg.addEventListener('click', e => { const i = nearest(e); if (i >= 0) showPerson(i); });
const candidates = people.filter(p => p.n >= 3).map(p => p.i);
document.getElementById('someone').addEventListener('click', () => {
