<style>
/* ══ tokens ══════════════════════════════════════════════════════════════
   Pure black ground. Colour lives only INSIDE objects — never as a wash.
   Single committed visual world: every colour painted explicitly. */
:root{
  --void:#000000;

  /* the plurality ramp, read off the reference strip:
     índigo → violeta → periwinkle → azul claro → orquídea → lavanda → menta → teal */
  --r-indigo:#4B3A93;
  --r-violet:#6E5FC4;
  --r-peri:#8A83E2;
  --r-sky:#93A6F0;
  --r-orchid:#A845DE;
  --r-lav:#A6A3C2;
  --r-mint:#A5D3AE;
  --r-teal:#7FA6A8;

  /* the two camps, taken from the two ends of the ramp that read apart */
  --nimby:#C85A5A;   /* red  · height sceptics      */
  --yimby:#7BA0E0;   /* blue · high-rise supporters */
  --fuse:#E3C2EB;    /* what red + blue make together on black */

  --txt:#F4F2F8;
  --txt-2:#A6A1B8;
  --txt-3:#6B6680;
  --line:rgba(255,255,255,.13);
  --line-2:rgba(255,255,255,.07);

  --f-disp:"Archivo",-apple-system,BlinkMacSystemFont,'Helvetica Neue',Arial,sans-serif;
  --f-body:"Public Sans",-apple-system,BlinkMacSystemFont,'Helvetica Neue',Arial,sans-serif;
  --f-mono:"JetBrains Mono",ui-monospace,'SF Mono',Menlo,monospace;

  --pad:clamp(1.15rem,4.5vw,3.5rem);
  --measure:38rem;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;background:var(--void)}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

body{
  margin:0;
  background:var(--void);
  color:var(--txt);
  font-family:var(--f-body);
  font-size:clamp(1rem,.95rem + .2vw,1.08rem);
  font-weight:390;
  line-height:1.68;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}

/* ══ chrome ═════════════════════════════════════════════════════════════ */
/* The bar rides at the top of the hero and scrolls away with it, rather than
   following the page down. It sits on the hero's own black, so it carries no
   ground and no rule of its own — nothing to see once it has left. */
nav{
  position:relative;z-index:40;
  display:flex;align-items:center;gap:1.5rem;
  padding:1.15rem var(--pad) .4rem;
}
/* The nav keeps its own dark ground the whole way down the page, so white
   marks stay legible over the cream half as well as over the hero. The two
   logos are sized by optical weight rather than to a common height: the
   AMPLIFY mark carries its own padded block, the RxC one is a bare wordmark,
   so matching their heights would make AMPLIFY read smaller than it is. */
.brand{display:flex;align-items:center;gap:.72rem;text-decoration:none;line-height:0}
.brand img{display:block;width:auto}
.lg-amp{height:40px}
.lg-rxc{height:30px}
.lg-x{font-family:var(--f-mono);font-size:.8rem;color:var(--txt-3);line-height:1}
.brand:focus-visible{outline:2px solid var(--txt);outline-offset:4px;border-radius:2px}
@media (max-width:520px){.lg-amp{height:30px}.lg-rxc{height:22px}.lg-x{font-size:.7rem}}
nav .links{margin-left:auto;display:flex;gap:1.35rem}
nav a{font-family:var(--f-mono);font-size:.66rem;letter-spacing:.09em;text-transform:uppercase;
  color:var(--txt-3);text-decoration:none;transition:color .2s}
nav a:hover{color:var(--txt)}
nav a:focus-visible{outline:2px solid var(--yimby);outline-offset:3px;border-radius:2px}
@media (max-width:720px){nav .links{display:none}}

.wrap{max-width:74rem;margin:0 auto;padding:0 var(--pad);position:relative;z-index:2}
.col{max-width:var(--measure)}
section{scroll-margin-top:1.5rem}
p{margin:0 0 1.1em}

.eyebrow{font-family:var(--f-mono);font-size:.66rem;font-weight:500;letter-spacing:.19em;
  text-transform:uppercase;color:var(--txt-3);margin:0 0 1.2rem}
h2{font-family:var(--f-disp);font-weight:800;
  font-size:clamp(1.9rem,4.6vw,3.3rem);line-height:1.02;
  font-variation-settings:"wdth" 108;letter-spacing:-.022em;
  margin:0 0 1.1rem;max-width:19ch;text-wrap:balance;color:var(--txt)}
.intro{font-size:clamp(1.02rem,1.5vw,1.18rem);color:var(--txt-2);max-width:44rem;margin:0 0 2.6rem}
/* every other block treats <em> as weight, not slant; .intro was the one that
   never got the rule, so its one italic sat in a visible gap of its own side
   bearing and read as a double space */
.intro em{color:var(--txt);font-style:normal;font-weight:600}

/* the reference ramp, stops packed tight so the hues stay adjacent
   rather than smearing into one another. Loops back to indigo at 100%. */
.grad{
  background:linear-gradient(96deg,
    #7B52F0 0%,    #6A62EC 5%,    #5F8AE4 9%,
    #5FC8D8 13%,   #6A9CE8 17%,   #7B62F0 22%,   #9068F4 28%,
    #BFC8FF 33%,   #EEF0FF 36%,   #C4B0FC 39%,   #A07AF6 44%,
    #8A5CF0 50%,   #7642E4 57%,   #8B5CF6 64%,   #A47AF8 71%,
    #C0A0FA 77%,   #E4D6FE 82%,   #C0A0FA 86%,   #A47AF8 90%,
    #8E62F2 95%,   #7B52F0 100%);
  background-size:260% 100%;
  -webkit-background-clip:text;background-clip:text;color:transparent;
  animation:gradsweep 14s linear infinite;
}

@media (prefers-reduced-motion:reduce){.grad{animation:none}}

/* ══ the cream half ══════════════════════════════════════════════════════
   Everything from the 73% down runs on cream. Rather than rewrite each
   component, the palette tokens are redefined on this one wrapper and the
   components inherit — they were all built to read from tokens, so they
   flip wholesale. Only the things that assume a dark ground need real
   changes, and those are handled explicitly below. */
.cream{
  --void:#FDF8E2;
  --txt:#221E14;
  --txt-2:#57523F;
  --txt-3:#8A8265;
  --line:rgba(34,30,20,.24);
  --line-2:rgba(34,30,20,.12);
  --navy:#1E3A5F;
  --track:#E8E6D8;
  background:var(--void);
  color:var(--txt);
}
/* The display gradient has to come down in value on cream — the pale
   lilacs that glowed on black would disappear against the paper.
   background is a shorthand, so declaring it here resets every background
   sub-property back to its initial value, background-clip included. The
   clip has to be restated or the gradient stops being cut to the glyphs
   and paints as a solid block behind them, with the transparent text
   invisible on top of it. */
.cream .grad{
  background:linear-gradient(96deg,
    #5A2FC8 0%,   #4C46C0 8%,   #3E7AB8 14%,
    #3FA8B4 19%,  #4C7CC8 25%,  #5F44D8 32%,
    #7A3AE0 40%,  #9448E4 48%,  #7C34D8 56%,
    #6A2ECC 64%,  #8A48E0 73%,  #A268E8 81%,
    #7E3EDC 90%,  #5A2FC8 100%);
  background-size:260% 100%;
  -webkit-background-clip:text;background-clip:text;
  color:transparent;
}

/* ══ hero ═══════════════════════════════════════════════════════════════ */
/* the nav is in normal flow now, so the hero no longer has to reserve room
   for it — it just claims what is left of the first screen */
.hero{min-height:calc(100svh - 5rem);display:flex;flex-direction:column;justify-content:center;padding:3rem 0}
h1{
  font-family:var(--f-disp);font-weight:900;
  font-size:clamp(2.9rem,11.5vw,9rem);line-height:.86;
  font-variation-settings:"wdth" 112;letter-spacing:-.038em;
  margin:1.4rem 0 0;text-wrap:balance;
}
/* The fluid colour loop, clipped inside the word.
   The CSS gradient below is the floor — it renders on its own if the canvas
   never paints. The canvas then overlays the real liquid motion, already cut
   to the letterforms, so no blend mode is involved. */
.fluid{
  position:relative;display:inline-block;
  background:linear-gradient(96deg,
    #4B3A93 0%, #5A46A6 6%, #6E5FC4 12%, #8A83E2 19%, #9C9DEE 25%,
    #93A6F0 31%, #A96FE8 38%, #A845DE 45%, #9C63C9 52%, #A6A3C2 59%,
    #ADB4C8 65%, #A5D3AE 72%, #9BD2A9 79%, #7FA6A8 87%, #6D9099 93%, #4B3A93 100%);
  background-size:240% 100%;
  -webkit-background-clip:text;background-clip:text;
  color:transparent;
  animation:drift 9s linear infinite;
}
@keyframes drift{to{background-position:260% 0}}
/* .grad is its own single-layer ramp elsewhere on the page and travels
   horizontally on its own timing. */
@keyframes gradsweep{to{background-position:-260% 0}}
@media (prefers-reduced-motion:reduce){.fluid{animation:none}}
/* once the canvas has actually painted, retire the CSS floor so the two
   sets of glyphs can't fringe against each other */
.fluid.painted{background:none;animation:none}
/* line-height is .86, so the glyphs are taller than the span box — the
   canvas has to overflow it vertically or the B and the y get clipped. */
.fluid .fx{position:absolute;left:0;top:-25%;width:100%;height:150%;pointer-events:none}
/* The two camps in the headline. The magenta is AMPLIFY's own, straight from
   their mark. The data sections below keep the site's red/blue coding for the
   same two camps. */
h1 .yimby{color:#e7f177;display:inline-block}
h1 .nimby{color:#ae117c;display:inline-block}
h1 .vs{
  font-variation-settings:"wdth" 75;font-weight:400;font-style:italic;
  font-size:.36em;color:var(--txt-3);vertical-align:.36em;padding:0 .2em;letter-spacing:0;
}
.lede{font-size:clamp(1.08rem,1.9vw,1.4rem);line-height:1.5;color:var(--txt-2);max-width:34rem;margin:2.2rem 0 0}
.lede em{color:var(--txt);font-style:normal;font-weight:600}
.hero-meta{display:flex;flex-wrap:wrap;gap:.5rem 1.6rem;margin-top:3rem;
  font-family:var(--f-mono);font-size:.66rem;letter-spacing:.11em;text-transform:uppercase;color:var(--txt-3)}

/* ══ marquee ════════════════════════════════════════════════════════════ */
.marquee{overflow:hidden;border-top:1px solid var(--line-2);border-bottom:1px solid var(--line-2);padding:1.05rem 0}
.mq-track{display:flex;gap:2.6rem;width:max-content;animation:mq 46s linear infinite}
@keyframes mq{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){.mq-track{animation:none}}
.mq-item{font-family:var(--f-mono);font-size:.72rem;letter-spacing:.13em;text-transform:uppercase;
  color:var(--txt-3);white-space:nowrap;display:flex;align-items:center;gap:2.6rem}
.mq-item::after{content:"";width:4px;height:4px;border-radius:50%;background:var(--r-peri)}

/* ══ big stat ═══════════════════════════════════════════════════════════ */
.stat-sec{padding:clamp(5rem,14vw,9rem) 0;text-align:center}
.giant{font-family:var(--f-disp);font-weight:900;
  font-size:clamp(6rem,26vw,20rem);line-height:.82;
  font-variation-settings:"wdth" 105;letter-spacing:-.05em;
  margin:.5rem 0;font-variant-numeric:tabular-nums}
.stat-cap{font-size:clamp(1.05rem,1.9vw,1.32rem);color:var(--txt-2);max-width:36rem;margin:1.4rem auto 0;line-height:1.5}
.stat-cap em{color:var(--txt);font-style:normal;font-weight:600}

.sec{padding:clamp(4rem,10vw,7rem) 0;border-top:1px solid var(--line-2)}

/* ══ publics + tools ════════════════════════════════════════════════════ */
.publics{display:grid;grid-template-columns:repeat(auto-fit,minmax(17rem,1fr));gap:1.1rem;margin:0 0 3.5rem}
.pub{border:1px solid var(--line);padding:1.6rem 1.5rem;border-radius:3px;position:relative;overflow:hidden;background:var(--void)}
.pub::before{content:"";position:absolute;top:0;left:0;width:100%;height:2px}
.pub.a::before{background:linear-gradient(90deg,var(--nimby),transparent)}
.pub.b::before{background:linear-gradient(90deg,var(--yimby),transparent)}
.pub .tag{font-family:var(--f-mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--txt-3)}
.pub .n{font-family:var(--f-disp);font-weight:900;font-size:3.4rem;line-height:1;margin:.7rem 0 .1rem;
  font-variation-settings:"wdth" 100;font-variant-numeric:tabular-nums}
.pub.a .n{color:var(--nimby)}
.pub.b .n{color:var(--yimby)}
.pub h4{font-family:var(--f-disp);font-weight:700;font-size:1.02rem;margin:.2rem 0 .7rem;
  font-variation-settings:"wdth" 105;color:var(--txt)}
.pub p{font-size:.92rem;color:var(--txt-2);margin:0;line-height:1.6}

.tools{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:1px;
  background:var(--line-2);border:1px solid var(--line-2);border-radius:3px;overflow:hidden}
.tool{background:var(--void);padding:1.5rem 1.35rem}
.tool .step{font-family:var(--f-mono);font-size:.66rem;letter-spacing:.1em;color:var(--txt-3)}
.tool h5{font-family:var(--f-disp);font-weight:700;font-size:1.05rem;margin:.75rem 0 .3rem;
  font-variation-settings:"wdth" 105;color:var(--txt)}
/* the first three tools are real platforms, so their names carry a link out
   to the people who built them. The fourth is a survey design, with nowhere
   to send anyone, so it stays plain type. */
.tool h5 a{color:inherit;text-decoration:none;border-bottom:1px solid var(--line);
  padding-bottom:.08em;transition:border-color .18s,color .18s}
.tool h5 a:hover{border-bottom-color:currentColor}
.tool h5 a:focus-visible{outline:2px solid currentColor;outline-offset:3px;border-radius:2px}
.tool h5 a::after{content:"↗";font-family:var(--f-mono);font-size:.62em;
  color:var(--txt-3);margin-left:.34em;vertical-align:.22em;border:0}
.tool h5 a:hover::after{color:inherit}
.tool .role{font-family:var(--f-mono);font-size:.63rem;letter-spacing:.09em;text-transform:uppercase;margin:0 0 .7rem}
.tool:nth-child(1) .role{color:var(--yimby)}
.tool:nth-child(2) .role{color:var(--r-peri)}
.tool:nth-child(3) .role{color:var(--nimby)}
.tool:nth-child(4) .role{color:var(--r-sky)}
.tool p{font-size:.88rem;color:var(--txt-2);margin:0;line-height:1.6}

/* ══ findings ═══════════════════════════════════════════════════════════ */
.finds{display:flex;flex-direction:column;border-top:1px solid var(--line-2)}
.find{display:grid;grid-template-columns:4.5rem 1fr;gap:0 1.5rem;padding:2rem 0;border-bottom:1px solid var(--line-2)}
/* the last one's rule and the next section's top rule were stacking into two
   lines with only padding between them; the section boundary is marked once */
.find:last-child{border-bottom:0}
@media (max-width:640px){.find{grid-template-columns:1fr;gap:.6rem}}
.find .num{font-family:var(--f-disp);font-weight:900;font-size:2.3rem;line-height:1;
  font-variation-settings:"wdth" 90;color:transparent;
  background:linear-gradient(140deg,var(--yimby),var(--r-peri),var(--nimby));
  -webkit-background-clip:text;background-clip:text}
.find h3{font-family:var(--f-disp);font-weight:700;font-size:clamp(1.2rem,2.3vw,1.6rem);line-height:1.18;
  font-variation-settings:"wdth" 105;letter-spacing:-.012em;margin:0 0 .7rem;max-width:26ch;
  text-wrap:balance;color:var(--txt)}
.find p{font-size:.98rem;color:var(--txt-2);margin:0;max-width:46rem}
.find p em{color:var(--txt);font-style:normal;font-weight:600}

/* ══ conditions ═════════════════════════════════════════════════════════ */
.conds{display:grid;grid-template-columns:repeat(auto-fit,minmax(18rem,1fr));gap:1.1rem}
.cond{border:1px solid var(--line);border-radius:3px;padding:1.6rem 1.45rem;
  background:var(--void);position:relative;overflow:hidden}
.cond::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px}
.cond:nth-child(1)::after{background:linear-gradient(90deg,var(--yimby),var(--r-peri))}
.cond:nth-child(2)::after{background:linear-gradient(90deg,var(--r-teal),var(--yimby))}
.cond:nth-child(3)::after{background:linear-gradient(90deg,var(--nimby),var(--r-indigo))}
.cond:nth-child(4)::after{background:linear-gradient(90deg,var(--r-peri),var(--nimby))}
.cond:nth-child(5)::after{background:linear-gradient(90deg,var(--r-violet),var(--yimby))}
.cond:nth-child(6)::after{background:linear-gradient(90deg,var(--nimby),var(--r-peri))}
.cond .label{font-family:var(--f-mono);font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--txt-3);margin:0 0 .9rem}
.cond h4{font-family:var(--f-disp);font-weight:700;font-size:1.2rem;line-height:1.2;
  /* no colour of its own, so .grad can clip the ramp into the letterforms */
  font-variation-settings:"wdth" 105;margin:0 0 1.1rem;text-wrap:balance}
.cond .desc{font-size:.88rem;color:var(--txt-2);margin:0 0 1.1rem;line-height:1.55}
.cond .desc em{color:var(--txt);font-style:normal;font-weight:600}
.cond .quote{font-size:.9rem;color:var(--txt-2);font-style:italic;margin:0;
  padding-top:1rem;border-top:1px solid var(--line-2);line-height:1.55}

/* ══ additive consensus bars ════════════════════════════════════════════ */


/* ══ uncommon ground ════════════════════════════════════════════════════
   The paired percentages carry the whole point here: these are statements
   where the two clusters land within 15 points of each other, so the two
   numbers sitting almost level IS the finding. No bars — a bar chart of
   near-identical values would say less than the pair does. */

.ug{display:grid;grid-template-columns:repeat(auto-fit,minmax(21rem,1fr));gap:clamp(2rem,4vw,3.5rem)}
.ug h3{font-family:var(--f-disp);font-weight:800;font-size:1.2rem;line-height:1.24;
  font-variation-settings:"wdth" 105;letter-spacing:-.012em;margin:0 0 .5rem;color:var(--txt)}
.ug .key{font-family:var(--f-mono);font-size:.6rem;letter-spacing:.11em;
  text-transform:uppercase;color:var(--txt-3);margin:0 0 1rem}
.ug .say{font-size:.93rem;color:var(--txt-2);margin:0 0 1.4rem;line-height:1.6}
/* Compact enough to carry all 23 statements without the section becoming a
   scroll: the id sits inline at the end of its sentence rather than on a
   line of its own, and the row padding is about half what a reading list
   would take. */
.ug ul{list-style:none;padding:0;margin:0;border-top:1px solid var(--line)}
.ug li{display:grid;grid-template-columns:4.3rem 1fr;gap:0 .85rem;padding:.5rem 0;
  border-bottom:1px solid var(--line-2);align-items:baseline}
@media (max-width:520px){.ug li{grid-template-columns:1fr;gap:.2rem}}
.pair{font-family:var(--f-disp);font-weight:900;font-size:.9rem;
  font-variation-settings:"wdth" 100;font-variant-numeric:tabular-nums;line-height:1.35}
.pair .a{color:var(--nimby)}
.pair .s{color:var(--txt-3);font-weight:400;padding:0 .06em}
.pair .b{color:var(--yimby)}
.ug li p{font-size:.82rem;line-height:1.42;margin:0;color:var(--txt)}
.ug li .id{font-family:var(--f-mono);font-size:.56rem;letter-spacing:.08em;
  text-transform:uppercase;color:var(--txt-3);margin-left:.45rem;white-space:nowrap}

/* ══ interactive ════════════════════════════════════════════════════════ */
/* the explorer card — cream panel sitting on a hard navy offset, no blur */
.play{
  border:2px solid var(--txt);border-radius:14px;
  padding:clamp(1.6rem,4vw,2.75rem);max-width:56rem;
  background:var(--void);
  box-shadow:14px 14px 0 var(--navy);
}
.play .hint{
  font-family:var(--f-mono);font-size:.68rem;font-weight:500;
  letter-spacing:.15em;text-transform:uppercase;
  color:var(--nimby);margin:0 0 1rem;
}
#stmt{
  font-family:var(--f-disp);font-weight:800;
  font-size:clamp(1.5rem,3.6vw,2.5rem);line-height:1.12;
  font-variation-settings:"wdth" 104;letter-spacing:-.02em;
  margin:0 0 2.4rem;min-height:2.3em;text-wrap:balance;color:var(--txt);
}
/* Two independent bars instead of one converging track. Each camp now reads
   on its own scale, which is what the statement actually asks — the old
   track needed a legend to explain what the overlap meant. */
.gauge{display:grid;grid-template-columns:auto 1fr auto;gap:1rem 1.25rem;align-items:center}
@media (max-width:640px){.gauge{grid-template-columns:1fr;gap:.3rem 0}}
.gauge .who{text-align:right;line-height:1.2}
@media (max-width:640px){.gauge .who{text-align:left}}
