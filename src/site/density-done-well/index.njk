<script>
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── fluid colour loop, painted inside the word "Beyond" ──────────────
     Liquid field is painted across the canvas, then cut to the glyphs with
     destination-in. No blend modes, no isolation — the canvas arrives
     already shaped like the word, so it composites over black correctly
     in every engine. Colours stay saturated because the blobs are alpha-
     blended, not summed: 'lighter' would drive everything to white.     */
  var TEXT = 'Beyond';
  var host = document.getElementById('fluid');
  var cv   = document.getElementById('fx');
  var ctx  = cv.getContext('2d');
  var DPR  = Math.min(window.devicePixelRatio || 1, 2);
  var BW = 0, BH = 0;                    // box size in CSS px
  var SPEED = 7;                         // ← flow rate. 1 ≈ 70s per orbit, 7 ≈ 10s

  // A full spectrum loop, weighted to the reference strip's cool end but
  // running all the way through aqua, lime, amber, coral and magenta before
  // returning to indigo. Many hues coexisting in one surface — the whole
  // point of plurality, and what makes the bar feel alive rather than tidy.
  // High-value hues, not pale ones: bright enough to hold the letterform
  // against pure black, saturated enough not to read as washed.
  var RAMP = [
    [0.00,'#5B2FD6'],[0.04,'#7A4AFF'],[0.08,'#9C6DFF'],[0.12,'#C2A0FF'],
    [0.16,'#A9BCFF'],[0.20,'#74C8FF'],[0.24,'#3ADCEC'],[0.28,'#45E8C0'],
    [0.32,'#7BE88E'],[0.36,'#B6F05C'],[0.40,'#EDE64F'],[0.44,'#FFC44A'],
    [0.48,'#FF9C55'],[0.52,'#FF7070'],[0.56,'#FF5FA0'],[0.60,'#FF8FD4'],
    [0.64,'#F274FF'],[0.68,'#CE7BFF'],[0.72,'#A855F7'],[0.76,'#8E5CF8'],
    [0.80,'#7E6DFF'],[0.84,'#6E88FF'],[0.88,'#93AEFF'],[0.92,'#8461F5'],
    [0.96,'#6C46E4'],[1.00,'#5B2FD6']
  ];
  var CYCLES = 1.3;                      // ramp repeats across the field's range
  var SCALE  = 1.15;                     // field frequency — lower = bigger, slower masses
  var STIR   = 0.85;                     // domain-warp amplitude — high values go psychedelic
  var OVER = 0.25;                       // canvas overflow above/below the box
  var CH = 0, OY = 0;                    // canvas height, box top inside it

  // The ramp baked into a 256-entry lookup table once, so the per-pixel loop
  // is an array index rather than any colour maths.
  var LUT = (function(){
    var lc = document.createElement('canvas');
    lc.width = 256; lc.height = 1;
    var lx = lc.getContext('2d');
    var g = lx.createLinearGradient(0, 0, 256, 0);
    for (var s = 0; s < RAMP.length; s++) g.addColorStop(RAMP[s][0], RAMP[s][1]);
    lx.fillStyle = g;
    lx.fillRect(0, 0, 256, 1);
    return lx.getImageData(0, 0, 256, 1).data;
  })();

  // Low-resolution buffer the fluid field is computed into, then scaled up.
  // The field is smooth by construction, so the upscale costs no detail and
  // saves ~16x the per-pixel work.
  var fc = document.createElement('canvas');
  var fx = fc.getContext('2d', {willReadFrequently: true});
  var fimg = null, FW = 0, FH = 0;

  function sizeCanvas(){
    var b = host.getBoundingClientRect();
    if (b.width < 2 || b.height < 2) return false;
    BW = b.width; BH = b.height;
    CH = BH * (1 + OVER * 2);
    OY = BH * OVER;
    cv.width  = Math.round(BW * DPR);
    cv.height = Math.round(CH * DPR);

    var nfw = Math.max(64, Math.min(240, Math.round(BW / 3)));
    var nfh = Math.max(20, Math.round(nfw * CH / BW));
    if (nfw !== FW || nfh !== FH){
      FW = nfw; FH = nfh;
      fc.width = FW; fc.height = FH;
      fimg = fx.createImageData(FW, FH);
    }
    return true;
  }

  // Cheap smooth 2D noise: three sines whose arguments mix x and y, so the
  // contours are not aligned to either axis and no grid shows through.
  function nse(x, y){
    return Math.sin(x) * Math.cos(y * 1.31)
         + Math.sin(x * 1.73 + y * 0.61) * 0.60
         + Math.cos(y * 2.13 - x * 0.47) * 0.42;
  }

  function paint(t){
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.globalCompositeOperation = 'source-over';
    ctx.clearRect(0, 0, BW, CH);

    // No gradient at all any more. A linear gradient's colour is constant
    // along every line perpendicular to its axis — that is what a band IS —
    // so rotating, orbiting or warping one can only bend those bands, never
    // dissolve them. The structure survived every previous attempt.
    //
    // Instead the colour is a scalar field evaluated per pixel, with the
    // sampling position pushed around by the field itself before it is read.
    // That is domain warping: the coordinates get folded and stirred, so the
    // contours curl into each other and there is no axis left to line up on.
    // It is the standard way of getting ink-in-water out of smooth noise.
    var period = 9000 / SPEED * 7;
    var w = t / period;

    var t1 = w * 1.7, t2 = w * 1.3, t3 = w * 2.1, t4 = w * 0.9;
    var d = fimg.data;
    var p = 0;
    var SC = SCALE / FH;                  // field scale, isotropic in x and y
    var NORM = 1 / 2.05;                  // nse() range is about ±2.05

    for (var yy = 0; yy < FH; yy++){
      var ny = yy * SC;
      for (var xx = 0; xx < FW; xx++){
        var nx = xx * SC;

        // first pass: where to look
        var q1 = nse(nx + t1, ny - t2);
        var q2 = nse(nx - t3, ny + t4 + 2.7);
        // second pass: read from the stirred position. STIR has to stay
        // modest — push it past ~1.5 and the contours fold back on
        // themselves into tight curls, which is the psychedelic look
        var v  = nse(nx + STIR * q1, ny + STIR * q2);

        // wrap into the ramp — it starts and ends on the same colour, so
        // the wrap is seamless and CYCLES controls how dense the mixing is
        var u = (v * NORM * 0.5 + 0.5) * CYCLES + w * 0.30;
        u -= Math.floor(u);

        var li = (u * 255) << 2;
        d[p++] = LUT[li];
        d[p++] = LUT[li + 1];
        d[p++] = LUT[li + 2];
        d[p++] = 255;
      }
    }
    fx.putImageData(fimg, 0, 0);
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';

    // Bilinear upscaling alone still leaves faint blockiness where the field
    // changes fastest, so a small blur goes over the top. The image is drawn
    // with an overscan of the blur radius: without it the blur would pull in
    // transparency from beyond the edges and fade the outer strokes of the B
    // and the d before the glyph mask is even applied.
    var ob = Math.max(2, CH * 0.02);
    if ('filter' in ctx) ctx.filter = 'blur(' + ob.toFixed(1) + 'px)';
    ctx.drawImage(fc, -ob, -ob, BW + ob * 2, CH + ob * 2);
    if ('filter' in ctx) ctx.filter = 'none';

    // cut the field to the letterforms
    var cs = getComputedStyle(host);
    var fs = parseFloat(cs.fontSize) || 64;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.font = (cs.fontWeight || '900') + ' ' + fs + 'px ' + cs.fontFamily;
    if ('letterSpacing' in ctx) ctx.letterSpacing = cs.letterSpacing;
    var m = ctx.measureText(TEXT);
    var tw = m.width || BW;
    var asc  = m.actualBoundingBoxAscent  || fs * 0.72;
    var desc = m.actualBoundingBoxDescent || fs * 0.08;
    // the DOM box is set by the variable-width axis, which ctx.font can't
    // express — scale horizontally so the drawn glyphs match it exactly
    var kx = BW / tw;
    ctx.globalCompositeOperation = 'destination-in';
    ctx.setTransform(DPR * kx, 0, 0, DPR, 0, 0);
    ctx.fillStyle = '#000';
    // centre the glyphs on the span box, which sits OY down inside the canvas
    ctx.fillText(TEXT, 0, OY + (BH - (asc + desc)) / 2 + asc);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.globalCompositeOperation = 'source-over';
  }

  var last = 0;
  function loop(t){
    // 30fps: the field is now computed per pixel, and fluid motion this soft
    // reads no better at 45 than at 30
    if (t - last > 32){ paint(t); last = t; }
    requestAnimationFrame(loop);
  }
  // did the canvas actually end up with visible pixels? Only then is it safe
  // to retire the CSS gradient underneath — otherwise the word would vanish.
  function hasInk(){
    try {
      var d = ctx.getImageData(0, 0, cv.width, cv.height).data;
      for (var i = 3; i < d.length; i += 4 * 97) if (d[i] > 8) return true;
      return false;
    } catch (e) { return false; }
  }

  function start(){
    if (!sizeCanvas()){ requestAnimationFrame(start); return; }
    paint(performance.now());
    if (hasInk()) host.classList.add('painted');
    if (!reduce) requestAnimationFrame(loop);
  }
  // wait for the display face, or the box is measured at fallback-font size
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(start);
  else window.addEventListener('load', start);
  window.addEventListener('resize', function(){ if (sizeCanvas()) paint(performance.now()); });

  /* ── reveal + bar fills ───────────────────────────────────────────── */
  var io = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, {rootMargin:'0px 0px -8% 0px', threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });

  /* ── counters ─────────────────────────────────────────────────────── */
  var cio = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if (!e.isIntersecting) return;
      cio.unobserve(e.target);
      var el = e.target, target = parseFloat(el.dataset.target);
      if (reduce){ el.textContent = target; return; }
      var t0 = null, dur = 1100;
      function step(ts){
        if (!t0) t0 = ts;
        var k = Math.min(1, (ts - t0) / dur);
        el.textContent = Math.round(target * (1 - Math.pow(1 - k, 3)));
        if (k < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });
  }, {threshold:0.5});
  document.querySelectorAll('.count').forEach(function(el){ el.textContent = '0'; cio.observe(el); });

  /* ── height explorer ──────────────────────────────────────────────── */
  /* Every statement runs the SAME WAY: agreeing means accepting high-rise.
     The earlier set opened on "No to massive high-rise buildings", where
     agreeing means the opposite — so on a single bar the sceptics appeared
     to warm to height at the very moment they were hardening against it.
     Ordered here by how far the sceptic cluster actually travels: 41 → 81. */
  var STATES = {
    bare:        {t:'NIMBYs/Boomers who complain about high rises need to accept we are in a growing city.', a:41, b:87},
    opportunity: {t:'I do feel there needs to be high rise buildings as it does create more opportunities for people to live in.', a:47, b:85},
    land:        {t:'Sydney lacks the space to build horizontally, so vertical development may be the way.', a:51, b:90},
    form:        {t:'High-rises on main roads, low-rise on backstreets — density done right.', a:71, b:68},
    stations:    {t:'High density with shops and amenities near existing stations.', a:72, b:81},
    affordable:  {t:'More affordable housing; high-rises are fine in certain areas.', a:81, b:90}
  };
  var stmt = document.getElementById('stmt');
  var vn = document.getElementById('bv-n'), vy = document.getElementById('bv-y');

  function apply(key){
    var s = STATES[key];
    if (!s) return;
    stmt.textContent = s.t;
    document.getElementById('bf-n').style.width = s.a + '%';
    document.getElementById('bf-y').style.width = s.b + '%';
    vn.textContent = s.a + '%';
    vy.textContent = s.b + '%';
  }
  document.getElementById('toggles').addEventListener('click', function(ev){
    var btn = ev.target.closest('.tg');
    if (!btn) return;
    this.querySelectorAll('.tg').forEach(function(b){ b.classList.remove('on'); });
    btn.classList.add('on');
    apply(btn.dataset.key);
  });

  /* Draw the opening state straight away rather than waiting for the card
     to scroll into view — the bars should be readable the moment the
     section is, without anyone having to press a button first. The key is
     taken from whichever toggle is marked active in the markup, so the two
     can never drift apart again: this used to name its state literally, and
     when the states were renamed it went on asking for one that no longer
     existed, which left both bars sitting at zero until a click. */
  var first = document.querySelector('.tg.on');
  if (first) apply(first.dataset.key);
})();
</script>

