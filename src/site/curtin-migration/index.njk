<title>Curtin on migration: what 266 people told us</title>
<meta name="description" content="Results from the Curtin community conversation on migration, October 2026: two groups, where they still agree, and the changes people want most.">
<style>

:root{
  /* Kate Chaney MP's brand (katechaney.com.au): teal and navy, Barlow Semi Condensed and Inter.
     The groups get their own pair, amber and violet, so neither carries the MP's colours. */
  --fizz:#16A1B7; --on-fizz:#012253; --navy:#012253; --soft:#D3EFF4;
  --g1:#B45309; --g2:#8547F0;
  --paper:#ffffff; --ink:#012253; --card:#ffffff; --muted:#4B5B73;
  --line:rgba(1,34,83,.14); --track:#E3E9F0; --tint:#E8F6F9; --deep:#012253;
  --hk:.92; /* Barlow sets wider than the old display face, so the hero headline is scaled to keep its line breaks */
  --display:"Barlow Semi Condensed","Arial Narrow",Arial,sans-serif; --text:"Inter","Helvetica Neue",Arial,sans-serif;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#0B1629; --ink:#ffffff; --card:#14243C; --muted:#AFBBCC;
    --line:rgba(255,255,255,.16); --track:#2B3B55; --tint:#0F2C38; --deep:#010E22; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --paper:#0B1629; --ink:#ffffff; --card:#14243C; --muted:#AFBBCC;
  --line:rgba(255,255,255,.16); --track:#2B3B55; --tint:#0F2C38; --deep:#010E22; color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth;-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;font-family:var(--text);color:var(--ink);background:var(--paper);font-size:18px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:77.5rem;margin:0 auto;padding:0 40px}
h1,h2,h3{font-family:var(--display);font-weight:600;margin:0;letter-spacing:-.01em;font-feature-settings:"lnum" 1}
p{margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.btn{display:inline-flex;align-items:center;padding:.95rem 1.5rem;border-radius:999px;font-weight:600;font-size:1.02rem;text-decoration:none;border:2px solid var(--navy);font-family:inherit;cursor:pointer}
.btn.solid{background:var(--navy);color:#fff}
.btn.line{background:transparent;color:var(--navy)}
.btn:hover{transform:translateY(-1px)}
.dot{width:12px;height:12px;border-radius:50%;display:inline-block;flex:none}
.dot.g1{background:var(--g1)} .dot.g2{background:var(--g2)}
.pill{display:inline-block;font-weight:600;font-size:.9rem;background:var(--navy);color:#fff;border-radius:99px;padding:.3rem .85rem}
q{quotes:"“" "”"}

/* ---------- hero ---------- */
.hero{background:var(--fizz);color:var(--on-fizz);overflow:hidden}
.hero :focus-visible{outline-color:var(--navy)}
.hero-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:48px;align-items:center;padding:88px 0 100px}
.hero h1{font-size:calc(var(--hk) * clamp(3.4rem,7.6vw,7rem));line-height:.9;margin-bottom:34px}
.hero .sub{font-size:1.4rem;line-height:1.45;max-width:30rem;margin-bottom:36px}
.hero .sub b{font-weight:600;background:var(--navy);color:#fff;padding:0 .3em;border-radius:6px;-webkit-box-decoration-break:clone;box-decoration-break:clone}
.actions{display:flex;gap:14px;flex-wrap:wrap}
.cards{position:relative;display:flex;flex-direction:column;gap:20px;padding-top:max(10px,calc(3.43rem - 56px))}
.card{position:relative;width:82%;background:#fff;color:var(--navy);border-radius:18px;padding:22px 26px;box-shadow:0 18px 40px -18px rgba(0,0,0,.45)}
.card q{display:block;font-weight:600;font-size:1.2rem;line-height:1.34}
.c1{align-self:flex-start;width:calc(100% - 8.85rem + 22px);transform:rotate(-1.5deg)}
.c2{align-self:flex-end;transform:rotate(1.5deg)}
.c3{align-self:flex-start;transform:rotate(-1deg)}
.c4{align-self:flex-end;transform:rotate(2deg)}
.sticker{position:absolute;top:0;right:-22px;width:8.25rem;height:8.25rem;border-radius:50%;background:var(--navy);color:var(--fizz);display:grid;place-items:center;text-align:center;transform:rotate(-12deg);z-index:3}
.sticker b{display:block;font-family:var(--display);font-weight:700;font-size:3rem;line-height:.85;font-feature-settings:"lnum" 1}
.sticker span{font-size:.64rem;font-weight:600;line-height:1.18}
/* The sticker sits beside the first card and covers no card, at any text size.
   .c1 stops short of it: the sticker's 8.25rem, plus a .6rem gap, less its 22px overhang.
   The cards' top padding grows with the text, so the sticker ends above the second card
   even when the first card is at its shortest (three lines). See the README, "Layout".
   Below: very large text in a narrow window leaves no room beside the first card, so the
   sticker sits under the cards, as it does on phones. Never matches at the standard 16px. */
@media (min-width:901px) and (max-width:56.25em){
  .cards{padding-top:10px}
  .c1{width:82%}
  .sticker{position:relative;top:auto;right:auto;align-self:center;margin-top:8px}
}
/* Short windows: keep the headline, lede and buttons on the first screen. See the README, "Layout".
   The space above the hero shrinks first. The headline is the smallest of three sizes:
   its usual 7.6vw; its four-line size where the window is tall enough for four lines,
   otherwise the largest size that sets in three lines (7.7rem - 13px); and, on very short
   windows, a size that leaves room for the lede and buttons. Tall windows are unchanged. */
@media (min-width:901px){
  .hero-grid{padding-top:clamp(28px,calc(100vh - 41.5rem),88px)}
  .hero h1{font-size:calc(var(--hk) * clamp(3.4rem,min(7.6vw,max(calc(7.7rem - 13px),calc(27.78vh - 7.45rem)),calc(37.04vh - 8.73rem)),7rem))}
}
/* Short windows: Barlow's extra width would push the buttons off the first screen, so scale the headline further */
@media (min-width:901px) and (max-height:47.5em){ :root{--hk:.8} }
@media (min-width:901px) and (max-height:40em){ :root{--hk:.74} }
/* Where the cards run well past the first screen, the headline starts level with them
   instead of sitting halfway down: very short windows, and narrow ones that are not tall. */
@media (min-width:901px) and (max-height:43.25em),(min-width:901px) and (max-width:62.5em) and (max-height:53em){
  .hero-grid{align-items:start}
}

/* ---------- sections ---------- */
section.block{padding:110px 0}
.head{margin-bottom:52px}
.head h2{font-size:clamp(3rem,5.6vw,5.4rem);line-height:.92;max-width:24ch}
#prio-h{max-width:none}
.head p{font-size:1.2rem;line-height:1.45;max-width:32rem}
.deep{background:var(--deep);color:#fff}
.deep .head p{color:#C8D3E2}
.tint{background:var(--tint)}

/* ---------- map ---------- */
.map-card{position:relative;border:2px solid var(--ink);border-radius:28px;padding:22px 26px 18px;background:var(--card)}
.map-top{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:6px}
.map-legend{display:flex;gap:22px;flex-wrap:wrap;font-size:.98rem;font-weight:500}
.map-legend span{display:inline-flex;align-items:center;gap:8px}
.someone{font:inherit;font-size:.95rem;font-weight:600;background:var(--ink);color:var(--paper);border:0;border-radius:99px;padding:.55rem 1.1rem;cursor:pointer}
#map{display:block;width:100%;height:auto;touch-action:manipulation;cursor:crosshair;overflow:visible}
#map .pdot{transition:transform 1.2s cubic-bezier(.2,.75,.2,1),fill .6s ease,opacity .6s ease}
#map .axis{stroke:var(--ink);stroke-width:2}
#map .axis-label{fill:var(--ink);font-family:var(--text);font-weight:600}
#map .axis-note{fill:var(--muted);font-family:var(--text)}
.map-hint{font-size:.95rem;color:var(--muted);margin-top:4px}
.map-lead{font-weight:600;font-size:1.05rem;margin-bottom:10px}
.person{position:absolute;z-index:5;width:330px;background:var(--card);color:var(--ink);border:2px solid var(--ink);border-radius:18px;padding:16px 18px 14px;box-shadow:0 18px 40px -20px rgba(0,0,0,.5);font-size:.92rem;line-height:1.4;pointer-events:none;opacity:0;transform:translateY(4px);transition:opacity .15s ease,transform .15s ease}
.person.on{opacity:1;transform:none}
.person .pg{display:flex;align-items:center;gap:8px;font-weight:600;font-size:1rem;margin-bottom:6px}
.person .pn{color:var(--muted);margin-bottom:10px}
.person .pn b{color:var(--ink);font-weight:600}
.person .pv{border-top:1px solid var(--line);padding-top:9px;margin-top:9px}
.person .pv q{display:block;margin-bottom:5px}
.ans{display:inline-flex;align-items:center;gap:6px;font-weight:600;font-size:.85rem;border-radius:99px;padding:.15rem .6rem;background:var(--track);color:var(--ink)}
.ans.a{background:var(--fizz);color:var(--on-fizz)}
.ans.d{background:var(--ink);color:var(--paper)}
.person .why{font-size:.82rem;color:var(--muted);margin-top:10px}
.person .lean-h{font-weight:600;font-size:.88rem;margin:12px 0 7px}
.lean{display:flex;height:12px;border-radius:99px;overflow:hidden;background:var(--track)}
.lean i{display:block;height:100%}
.lean .l1{background:var(--g1)} .lean .l2{background:var(--g2)}
.lean-n{display:flex;justify-content:space-between;gap:10px;font-size:.84rem;margin-top:6px}
.lean-n span{display:inline-flex;align-items:center;gap:6px}
.lean-n b{font-weight:600}
.person .note{margin-top:10px;font-size:.88rem;line-height:1.4}
.person .ex{border-top:1px solid var(--line);padding-top:9px;margin-top:10px}
.person .ex .exl{display:flex;align-items:center;gap:7px;font-size:.84rem;font-weight:600;margin-bottom:4px}
.person .ex q{display:block}
.dot.pale{background:linear-gradient(90deg,var(--g1) 50%,var(--g2) 50%);opacity:.42}

/* ---------- group cards ---------- */
.groups-row{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:28px}
.gcard{border-radius:28px;padding:30px 30px 30px;color:#fff}
.gcard.one{background:var(--g1)} .gcard.two{background:var(--g2)}
.gtop{display:flex;align-items:flex-end;gap:20px;margin-bottom:22px}
.gtop .big{font-family:var(--display);font-weight:600;font-size:6.4rem;line-height:.78;font-feature-settings:"lnum" 1}
.gtop .big .pc{font-family:var(--text);font-weight:600;font-size:.4em;vertical-align:top;position:relative;top:.12em;margin-left:.04em}
.gtop .who{font-size:1.1rem;line-height:1.3;padding-bottom:4px}
.gtop .who b{display:block;font-size:1.45rem;font-weight:600}
.qbox{background:var(--card);color:var(--ink);border-radius:18px;padding:18px 22px 18px;margin-top:12px}
.qbox q{display:block;font-weight:600;font-size:1.12rem;line-height:1.32;margin-bottom:12px}
.qbox.lead q{font-size:1.32rem}
.qbox .lab{font-size:.88rem;color:var(--muted);margin-bottom:6px}
.pcts{display:flex;gap:8px 20px;font-size:.95rem;flex-wrap:wrap}
.pcts span{display:inline-flex;align-items:center;gap:8px}
.pcts b{font-weight:600}
.small-note{font-size:.95rem;color:var(--muted);margin-top:22px;max-width:46rem}

/* ---------- common ground band ---------- */
.common{margin-top:64px;border-radius:28px;background:var(--tint);padding:34px 38px;display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center}
.common q{display:block;font-family:var(--display);font-weight:600;font-feature-settings:"lnum" 1;font-size:clamp(1.9rem,3vw,2.6rem);line-height:1.02;margin-top:14px}

/* ---------- dumbbells ---------- */
.dumb{display:block;width:100%;height:auto;margin-top:14px;overflow:visible}
.dumb .trk{stroke:var(--trk,var(--track))}
.dumb .rng{stroke:var(--rng,var(--ink))}
.dumb .tick{fill:var(--tk,var(--muted));font-family:var(--text)}
.dumb .ring{stroke:var(--ring,var(--card))}
.vals{display:flex;gap:8px 22px;font-size:.98rem;margin-top:8px;flex-wrap:wrap}
.vals span{display:inline-flex;align-items:center;gap:8px}
.vals b{font-weight:600}
.nn{color:var(--muted);font-weight:400;font-size:.88em}
.half.agree .nn{color:#2C3E5A}

/* ---------- pairs ---------- */
.legend{display:flex;gap:26px;font-size:1rem;margin:0 0 32px;flex-wrap:wrap}
.legend span{display:inline-flex;align-items:center;gap:9px}
.pair{display:grid;grid-template-columns:1fr 1fr;border-radius:28px;overflow:hidden;margin-bottom:28px;background:var(--card);color:var(--ink)}
.pair .topic{grid-column:1/-1;display:flex;justify-content:space-between;align-items:baseline;gap:1rem;padding:26px 34px 0}
.pair .topic h3{font-size:2.6rem;line-height:1}
.pair .topic .n{font-size:.9rem;color:var(--muted);white-space:nowrap}
.half{padding:22px 34px 30px}
.half.split{margin:18px 0}
.half.agree{background:var(--soft);color:var(--navy);margin:18px 18px 18px 0;border-radius:20px;--trk:rgba(1,34,83,.18);--rng:var(--navy);--tk:#2C3E5A;--ring:var(--soft)}
.half.agree .pill{background:var(--navy);color:#fff}
.half q{display:block;font-weight:600;font-size:1.32rem;line-height:1.3;min-height:3.9em;margin-top:14px}

/* ---------- unlikely allies ---------- */
.head .head-line{margin-top:18px;max-width:42rem}
.allies-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:40px;align-items:start}
.amap-card{margin:0}
@media (min-width:901px){ .amap-card{position:sticky;top:24px} }  /* the short map stays beside the statements as they scroll */
.amap-lead{display:flex;align-items:center;gap:10px}
.amap-lead .dot{width:14px;height:14px}
.dot.ally{background:var(--fizz);box-shadow:inset 0 0 0 1.5px var(--navy)}
.dot.faint{background:linear-gradient(90deg,var(--g1) 50%,var(--g2) 50%);opacity:.3}
#amap{display:block;width:100%;height:auto;overflow:visible;margin-top:6px}
#amap .axis{stroke:var(--ink);stroke-width:2}
#amap .axis-label{fill:var(--ink);font-family:var(--text);font-weight:600}
.ablock{padding:22px 0;border-top:1px solid var(--line)}
.ablock:first-child{border-top:0;padding-top:2px}
.ablock h3{font-family:var(--text);font-weight:600;font-size:1.08rem;letter-spacing:0;line-height:1.3;margin-bottom:10px}
.ablock > p{font-size:1rem;line-height:1.45}
.acard{margin-top:18px}
.ablock > p + .acard{margin-top:14px}
.aquote{margin:0}
.aquote q{display:block;font-weight:600;font-size:1.04rem;line-height:1.35}
.aquote .gloss{display:block;font-size:.97rem;line-height:1.45;color:var(--muted);margin-top:4px}
.vs{display:grid;grid-template-columns:minmax(7.6rem,max-content) minmax(0,1fr) auto;align-items:center;gap:9px 16px;margin-top:12px;font-size:.95rem}
.vs-row{display:contents}
.vs-lab{display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
.vs-bar{height:12px;border-radius:99px;background:var(--track);overflow:hidden}
.vs-bar i{display:block;height:100%;border-radius:99px}
.vs-row.ally .vs-bar i{background:var(--fizz);box-shadow:inset 0 0 0 2px var(--navy)}
.vs-row.rest .vs-bar i{background:var(--ink);opacity:.28}
.vs-row b{font-weight:600;text-align:right;font-feature-settings:"tnum" 1}
.vs-lab .nn{display:block;font-size:.8rem;line-height:1.15}
@media (max-width:460px){
  .vs{grid-template-columns:minmax(0,1fr) auto;gap:5px 12px}
  .vs-lab{grid-column:1/-1;margin-top:6px}
  .vs-lab .nn{display:inline;margin-left:6px;font-size:.85rem}
}

/* ---------- priorities ---------- */
.key{display:flex;gap:22px;font-size:.95rem;margin:0 0 26px;flex-wrap:wrap}
.key span{display:inline-flex;align-items:center;gap:8px}
.key i{width:13px;height:13px;border-radius:50%;display:inline-block}
.prio-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.pcard{background:var(--card);border-radius:24px;padding:26px 26px 24px;display:flex;flex-direction:column;border:2px solid var(--ink)}
@supports (grid-template-rows:subgrid){.pcard{display:grid;grid-row:span 5;grid-template-rows:subgrid;row-gap:0}.pcard .echo{align-self:start}}
.pcard .rank{font-family:var(--display);font-weight:600;font-size:3.6rem;line-height:.8;margin-bottom:16px;font-feature-settings:"lnum" 1}
.pcard .tt{margin-bottom:22px;flex:1}
.pcard p.t{font-weight:600;font-size:1.16rem;line-height:1.3}
.pcard p.x{font-size:.9rem;color:var(--muted);margin-top:8px}
.waffle{display:grid;grid-template-columns:repeat(15,1fr);gap:4px;margin-bottom:12px}
.waffle i{aspect-ratio:1;border-radius:50%;background:var(--track)}
.waffle i.y{background:var(--fizz);box-shadow:inset 0 0 0 1.5px rgba(1,34,83,.6)}
.waffle i.n{background:var(--ink)}
.pstats{font-size:.95rem;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.pstats b{font-weight:600}
.no-card{margin-top:28px;background:var(--navy);color:#fff;border-radius:28px;padding:34px 38px;display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center}
.no-card h3{font-size:3rem;line-height:.95;margin:0 0 14px;color:var(--fizz)}
.no-card p.t{font-weight:600;font-size:1.35rem;line-height:1.3;margin-bottom:14px}
.no-card p.s{color:#C8D3E2;font-size:1rem}
.no-card .waffle{max-width:420px}
.no-card .waffle i{background:#2B4470}
.no-card .waffle i.y{background:var(--fizz);box-shadow:none}
.no-card .waffle i.n{background:#fff}
details.rest{margin-top:28px;border-top:2px solid var(--ink);padding-top:18px}
details.rest summary{cursor:pointer;font-weight:600;font-size:1.05rem;padding:.2rem 0}
.rest-list{list-style:none;margin:16px 0 0;padding:0}
.rest-list li{display:grid;grid-template-columns:3rem 1fr auto;gap:16px;align-items:baseline;padding:14px 0;border-top:1px solid var(--line)}
.rest-list .r{font-family:var(--display);font-weight:600;font-size:2rem;line-height:1;font-feature-settings:"lnum" 1}
.rest-list .t{font-weight:600}
.rest-list .s{font-size:.92rem;color:var(--muted);white-space:nowrap}

/* ---------- at a glance ---------- */
.glance{padding:64px 0 0}
.glance-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.gl{display:flex;flex-direction:column;gap:14px;border-radius:24px;padding:28px 28px 26px;text-decoration:none;color:var(--ink);border:2px solid var(--ink);background:var(--card);transition:transform .15s ease}
.gl:hover{transform:translateY(-3px)}
.gl h3{font-size:2.3rem;line-height:.98}
.gl p{font-size:1rem;line-height:1.45;flex:1}
.gl .more{font-weight:600;font-size:.95rem;text-decoration:underline;text-underline-offset:.2em}
.gl.dark{background:var(--navy);color:#fff;border-color:var(--navy)}
.gl.dark h3{color:var(--fizz)}
.gl.tinted{background:var(--tint)}
.split84{display:flex;height:18px;border-radius:99px;overflow:hidden}
.split84 i{display:block;height:100%}
.split84-n{display:flex;justify-content:space-between;font-size:.9rem;font-weight:600;margin-top:-6px}
.split84-n span{display:inline-flex;align-items:center;gap:7px}
.sub-head{margin:88px 0 28px}
.sub-head h3{font-size:clamp(2.4rem,4vw,3.6rem);line-height:.95}
.sub-head p{font-size:1.15rem;line-height:1.45;max-width:32rem}
.deep .common{color:var(--ink);margin:0 0 30px}
.harder{font-size:1.2rem;line-height:1.45;max-width:40rem;color:#C8D3E2;margin:56px 0 22px}
.harder b{color:#fff;font-weight:600}
.finding{font-family:var(--display);font-weight:600;font-size:clamp(1.9rem,3vw,2.6rem);line-height:1;margin:0 0 30px;max-width:46rem;font-feature-settings:"lnum" 1}
.echo{border-top:1px solid var(--line);margin-top:18px;padding-top:14px}
.echo .el{font-size:.85rem;font-weight:600;margin-bottom:6px}
.echo q{display:block;font-size:.95rem;line-height:1.38;margin-bottom:4px}
.echo .vals{font-size:.9rem;margin-top:6px}
.next{background:var(--fizz);color:var(--on-fizz);padding:110px 0;position:relative;overflow:hidden}
.next-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:center}
.next h2{font-size:clamp(3.4rem,7vw,6.6rem);line-height:.9;margin-bottom:26px}
.next p{font-size:1.35rem;line-height:1.45;max-width:32rem;margin-bottom:34px}
.next .sticker2{justify-self:center;width:15rem;height:15rem;border-radius:50%;background:var(--navy);color:var(--fizz);display:grid;place-items:center;text-align:center;transform:rotate(-10deg)}
.next .sticker2 b{font-family:var(--display);font-weight:700;font-size:3.6rem;line-height:.9;display:block}
.next .sticker2 > div{max-width:72%} /* keeps the wider Barlow words inside the circle */

/* ---------- how the priority vote worked ---------- */
.how{display:grid;grid-template-columns:auto 1fr;gap:40px;align-items:center;background:var(--card);border:2px solid var(--ink);border-radius:24px;padding:26px 32px;margin-bottom:44px}
.costs{display:flex;gap:28px;align-items:flex-end}
.cost{display:flex;flex-direction:column;align-items:center;gap:10px;font-size:.92rem;text-align:center}
.cost b{font-weight:600}
.sq{display:grid;gap:3px}
.sq i{width:16px;height:16px;border-radius:3px;background:var(--fizz);box-shadow:inset 0 0 0 1.5px rgba(1,34,83,.6)}
.sq.s1{grid-template-columns:repeat(1,16px)} .sq.s4{grid-template-columns:repeat(2,16px)} .sq.s9{grid-template-columns:repeat(3,16px)}
.how p.cap{font-size:1.1rem;line-height:1.45;max-width:36rem}

/* ---------- how this worked ---------- */
.steps{list-style:none;margin:0 0 30px;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
.step{display:flex;flex-direction:column;gap:10px;border:2px solid var(--ink);border-radius:24px;padding:24px 24px 26px;background:var(--card)}
.step .fig{font-family:var(--display);font-weight:600;font-size:3.8rem;line-height:.85;font-feature-settings:"lnum" 1}
.step h3{font-family:var(--text);font-weight:600;font-size:1.1rem;letter-spacing:0;line-height:1.3;margin-top:6px}
.step p{font-size:.98rem;line-height:1.45;color:var(--muted)}
details.fine{border-top:2px solid var(--ink);padding-top:18px}
details.fine summary{cursor:pointer;font-weight:600;font-size:1.05rem;padding:.2rem 0}
details.fine .arows{margin-top:14px}

/* ---------- about rows ---------- */
.arows{border-bottom:1px solid var(--line)}
.arow{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:32px;padding:24px 0;border-top:1px solid var(--line)}
.arow h3{font-family:var(--text);font-weight:600;font-size:1.12rem;letter-spacing:0;line-height:1.35}
.arow p{font-size:1.02rem;line-height:1.55;max-width:44rem}

/* ---------- notes + footer ---------- */
.notes{display:grid;grid-template-columns:repeat(3,1fr);gap:34px 40px}
.notes h3{font-family:var(--text);font-weight:600;font-size:1.08rem;letter-spacing:0;margin-bottom:6px}
.notes p{font-size:.98rem;line-height:1.5}
.links{display:flex;gap:14px;flex-wrap:wrap;margin-top:44px}
.links .btn{border-color:var(--ink);color:var(--ink)}
.links .btn.solid{background:var(--ink);color:var(--paper)}
footer{background:var(--navy);color:#fff;padding:48px 0 56px}
.foot{display:grid;grid-template-columns:1fr 1fr;gap:32px}
.foot strong{font-weight:600}
.foot .ack{color:#C8D3E2;font-size:.95rem}

@media (max-width:900px){
  .wrap{padding:0 20px}
  .hero-grid,.head,.groups-row,.pair,.no-card,.allies-grid,.common,.foot,.glance-grid,.sub-head,.next-grid{grid-template-columns:1fr}
  .sub-head{margin:64px 0 20px}
  .how{grid-template-columns:1fr;gap:20px;padding:22px}
  .costs{gap:20px}
  .arow{grid-template-columns:1fr;gap:6px;padding:18px 0}
  .steps{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .step{padding:20px}
  .step .fig{font-size:3rem}
  .next{padding:72px 0}
  .next .sticker2{width:10.625rem;height:10.625rem}
  .next .sticker2 b{font-size:2.6rem}
  .glance{padding:44px 0 0}
  .hero-grid{padding:28px 0 64px;gap:28px}
  .hero .sub{font-size:1.2rem}
  .cards{gap:16px;padding:6px 4px 10px}
  .card,.c1,.c2,.c3,.c4{width:auto;align-self:stretch}
  .sticker{position:relative;top:auto;right:auto;align-self:center;margin-top:8px}
  .c1{transform:rotate(-2deg)} .c2{transform:rotate(1.5deg)} .c3{transform:rotate(-1deg)} .c4{transform:rotate(2deg)}
  section.block{padding:72px 0}
  .head{gap:18px;margin-bottom:32px}
  .gtop .big{font-size:4.6rem}
  .gcard{padding:24px 20px}
  .map-card{padding:16px 14px 14px;border-radius:22px}
  .person{position:static;width:auto;opacity:1;transform:none;margin-top:12px;box-shadow:none;display:none}
  .person.on{display:block}
  .half.agree{margin:0 14px 14px}
  .half.split{margin:6px 0 0}
  .pair .topic{padding:22px 22px 0;flex-wrap:wrap}
  .pair .topic h3{font-size:2.2rem}
  .half{padding:18px 22px 24px}
  .half q{min-height:0}
  .allies-grid{gap:28px}
  .vs{gap:9px 12px}
  .common{padding:26px 22px;gap:18px}
  .prio-grid{grid-template-columns:1fr}
  .no-card{padding:28px 22px;gap:22px}
  .notes{grid-template-columns:1fr}
  .rest-list li{grid-template-columns:2.4rem 1fr}
  .rest-list .s{grid-column:2;white-space:normal}
}
/* ---------- hover a card to bring it forward and fade the rest (mouse and trackpad only) ---------- */
@media (hover:hover) and (pointer:fine){
  .pair,.pcard,.no-card{transition:opacity .2s ease}
  #pairs:has(.pair:hover) .pair:not(:hover),
  #priorities:has(.pcard:hover) .pcard:not(:hover),
  #priorities:has(.pcard:hover) .no-card,
  #priorities:has(.no-card:hover) .pcard{opacity:.25}
}
@media (hover:hover) and (pointer:fine) and (prefers-reduced-motion:reduce){ .pair,.pcard,.no-card{transition:none} }
@media (max-width:520px){ .steps{grid-template-columns:1fr} }
@media (prefers-reduced-motion:reduce){ #map .pdot,.person,.gl{transition:none} .btn:hover,.gl:hover{transform:none} }

/* ---------- RxC site shell (shared with the other project microsites) ---------- */
