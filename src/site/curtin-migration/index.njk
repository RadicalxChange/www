    if (q.e) {
      const ec = document.createElement('div'); ec.className = 'echo';
      ec.innerHTML = `<p class="el">In the conversation, statement ${q.e[0]}</p><q></q><div class="vals">${q.e[2].map((v, g) => `<span><i class="dot g${g + 1}"></i>${NAME[g]} <b>${v}%</b>${q.e[3][g] < 20 ? `<span class="nn">(${q.e[3][g]} voted)</span>` : ''}</span>`).join('')}</div>${q.en ? '<p class="el" style="margin:6px 0 0;font-weight:400;color:var(--muted)"></p>' : ''}`;
      ec.querySelector('q').textContent = q.e[1];
      if (q.en) ec.querySelectorAll('.el')[1].textContent = q.en;
      c.appendChild(ec);
    }
    pg.appendChild(c);
  } else {
    const li = document.createElement('li');
    li.innerHTML = `<span class="r">${rankOf(q)}</span><span class="t"></span><span class="s"><b class="rnet">+${q.net}</b><span class="rs">${q.y} of ${VOTERS} backed it</span></span>`;
    li.querySelector('.t').textContent = q.t; rest.appendChild(li);
  }
});
</script>
