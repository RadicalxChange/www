  d.innerHTML = `<div class="topic"><h3></h3><span class="n">Statements ${p.split.id} and ${p.agree.id}</span></div>
    <div class="half split"><span class="pill">They split</span><q></q></div>
    <div class="half agree"><span class="pill">They agree</span><q></q></div>`;
  d.querySelector('h3').textContent = p.topic;
  const [qs, qa] = d.querySelectorAll('q'); qs.textContent = p.split.t; qa.textContent = p.agree.t;
  d.querySelector('.split').appendChild(dumbbell(p.split.a, p.split.b, p.split.n));
  d.querySelector('.agree').appendChild(dumbbell(p.agree.a, p.agree.b, p.agree.n));
  pairsRoot.appendChild(d);
});

/* ================= still open ================= */
const OPEN = [
  { id: 13, t: 'People who’ve studied, worked and paid tax here should get first shot at permanent places, ahead of new applicants from overseas.', g: [[53.3, 23.3, 23.3], [56.0, 21.0, 23.0]], take: 'Same mix in both groups: about half agree, a quarter disagree.' },
  { id: 29, t: 'Universities that bring people here should have to make sure they have decent housing, not leave it to the rental market.', g: [[58.1, 12.9, 29.0], [60.6, 19.3, 20.2]], take: 'Same mix in both groups: about 6 in 10 agree, 2 to 3 in 10 disagree.' }
];
const og = document.getElementById('open-grid');
OPEN.forEach(o => {
