<title>Curtin on migration: what 266 people told us</title>
<meta name="description" content="Results from the Curtin community conversation on migration, October 2026: two groups, where they still agree, and the changes people want most.">
<style>
@font-face{font-family:'Suisse Intl';src:url(data:font/woff2;base64,) format('woff2');font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:'Suisse Intl';src:url(data:font/woff2;base64,) format('woff2');font-weight:500;font-style:normal;font-display:swap}
@font-face{font-family:'Suisse Intl';src:url(data:font/woff2;base64,) format('woff2');font-weight:600;font-style:normal;font-display:swap}
@font-face{font-family:'Messer';src:url(data:font/woff2;base64,) format('woff2');font-weight:400;font-style:normal;font-display:swap}

:root{
  --fizz:#EDFF38; --on-fizz:#000;
  --g1:#6F45F0; --g2:#D6286A;
  --paper:#ffffff; --ink:#000000; --card:#ffffff; --muted:#555555;
  --line:rgba(0,0,0,.14); --track:#e4e4e4; --tint:#FAFFC3; --deep:#000000;
  --display:"Messer",Georgia,serif; --text:"Suisse Intl","Helvetica Neue",Arial,sans-serif;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#141414; --ink:#ffffff; --card:#1f1f1f; --muted:#b5b5b5;
    --line:rgba(255,255,255,.16); --track:#3b3b3b; --tint:#1a1c07; --deep:#000000; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --paper:#141414; --ink:#ffffff; --card:#1f1f1f; --muted:#b5b5b5;
  --line:rgba(255,255,255,.16); --track:#3b3b3b; --tint:#1a1c07; --deep:#000000; color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth;-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;font-family:var(--text);color:var(--ink);background:var(--paper);font-size:18px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:1240px;margin:0 auto;padding:0 40px}
h1,h2,h3{font-family:var(--display);font-weight:400;margin:0;letter-spacing:-.01em;font-feature-settings:"lnum" 1}
p{margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.btn{display:inline-flex;align-items:center;padding:.95rem 1.5rem;border-radius:999px;font-weight:600;font-size:1.02rem;text-decoration:none;border:2px solid #000;font-family:inherit;cursor:pointer}
.btn.solid{background:#000;color:#fff}
.btn.line{background:transparent;color:#000}
.btn:hover{transform:translateY(-1px)}
.dot{width:12px;height:12px;border-radius:50%;display:inline-block;flex:none}
.dot.g1{background:var(--g1)} .dot.g2{background:var(--g2)}
.pill{display:inline-block;font-weight:600;font-size:.9rem;background:#000;color:#fff;border-radius:99px;padding:.3rem .85rem}
q{quotes:"“" "”"}

/* ---------- hero ---------- */
.hero{background:var(--fizz);color:var(--on-fizz);overflow:hidden}
.hero :focus-visible{outline-color:#000}
.hero-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:48px;align-items:center;padding:88px 0 100px}
.hero h1{font-size:clamp(3.4rem,7.6vw,7.4rem);line-height:.9;margin-bottom:34px}
.hero .sub{font-size:1.4rem;line-height:1.45;max-width:30rem;margin-bottom:36px}
.hero .sub b{font-weight:600;background:#000;color:var(--fizz);padding:0 .3em;border-radius:6px;-webkit-box-decoration-break:clone;box-decoration-break:clone}
.actions{display:flex;gap:14px;flex-wrap:wrap}
.cards{position:relative;display:flex;flex-direction:column;gap:20px;padding-top:10px}
.card{position:relative;width:82%;background:#fff;color:#000;border-radius:18px;padding:22px 26px;box-shadow:0 18px 40px -18px rgba(0,0,0,.45)}
.card q{display:block;font-weight:600;font-size:1.2rem;line-height:1.34}
.c1{align-self:flex-start;transform:rotate(-1.5deg)}
.c2{align-self:flex-end;transform:rotate(1.5deg)}
.c3{align-self:flex-start;transform:rotate(-1deg)}
.c4{align-self:flex-end;transform:rotate(2deg)}
.sticker{position:absolute;top:-34px;right:-22px;width:132px;height:132px;border-radius:50%;background:#000;color:var(--fizz);display:grid;place-items:center;text-align:center;transform:rotate(-12deg);z-index:3}
.sticker b{display:block;font-family:var(--display);font-weight:400;font-size:3rem;line-height:.85;font-feature-settings:"lnum" 1}
.sticker span{font-size:.72rem;font-weight:600;line-height:1.18}

/* ---------- sections ---------- */
section.block{padding:110px 0}
.head{margin-bottom:52px}
.head h2{font-size:clamp(3rem,5.6vw,5.4rem);line-height:.92;max-width:24ch}
.head p{font-size:1.2rem;line-height:1.45;max-width:32rem}
.deep{background:var(--deep);color:#fff}
.deep .head p{color:#d6d6d6}
.tint{background:var(--tint)}

/* ---------- map ---------- */
.map-card{position:relative;border:2px solid var(--ink);border-radius:28px;padding:22px 26px 18px;background:var(--card)}
.map-top{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:6px}
.map-legend{display:flex;gap:22px;flex-wrap:wrap;font-size:.98rem;font-weight:500}
.map-legend span{display:inline-flex;align-items:center;gap:8px}
.someone{font:inherit;font-size:.95rem;font-weight:600;background:var(--ink);color:var(--paper);border:0;border-radius:99px;padding:.55rem 1.1rem;cursor:pointer}
#map{display:block;width:100%;height:auto;touch-action:manipulation;cursor:crosshair;overflow:visible}
#map .pdot{transition:transform 1.2s cubic-bezier(.2,.75,.2,1),fill .6s ease,opacity .6s ease}
#map .axis{stroke:var(--ink);stroke-width:2}
#map .axis-label{fill:var(--ink);font-family:var(--text);font-weight:600}
#map .axis-note{fill:var(--muted);font-family:var(--text)}
.map-hint{font-size:.95rem;color:var(--muted);margin-top:4px}
.map-lead{font-weight:600;font-size:1.05rem;margin-bottom:10px}
.person{position:absolute;z-index:5;width:330px;background:var(--card);color:var(--ink);border:2px solid var(--ink);border-radius:18px;padding:16px 18px 14px;box-shadow:0 18px 40px -20px rgba(0,0,0,.5);font-size:.92rem;line-height:1.4;pointer-events:none;opacity:0;transform:translateY(4px);transition:opacity .15s ease,transform .15s ease}
.person.on{opacity:1;transform:none}
.person .pg{display:flex;align-items:center;gap:8px;font-weight:600;font-size:1rem;margin-bottom:6px}
.person .pn{color:var(--muted);margin-bottom:10px}
.person .pn b{color:var(--ink);font-weight:600}
.person .pv{border-top:1px solid var(--line);padding-top:9px;margin-top:9px}
.person .pv q{display:block;margin-bottom:5px}
.ans{display:inline-flex;align-items:center;gap:6px;font-weight:600;font-size:.85rem;border-radius:99px;padding:.15rem .6rem;background:var(--track);color:var(--ink)}
.ans.a{background:var(--fizz);color:#000}
.ans.d{background:var(--ink);color:var(--paper)}
.person .why{font-size:.82rem;color:var(--muted);margin-top:10px}
.person .lean-h{font-weight:600;font-size:.88rem;margin:12px 0 7px}
.lean{display:flex;height:12px;border-radius:99px;overflow:hidden;background:var(--track)}
.lean i{display:block;height:100%}
.lean .l1{background:var(--g1)} .lean .l2{background:var(--g2)}
.lean-n{display:flex;justify-content:space-between;gap:10px;font-size:.84rem;margin-top:6px}
.lean-n span{display:inline-flex;align-items:center;gap:6px}
.lean-n b{font-weight:600}
.person .note{margin-top:10px;font-size:.88rem;line-height:1.4}
.person .ex{border-top:1px solid var(--line);padding-top:9px;margin-top:10px}
.person .ex .exl{display:flex;align-items:center;gap:7px;font-size:.84rem;font-weight:600;margin-bottom:4px}
.person .ex q{display:block}
.dot.pale{background:linear-gradient(90deg,var(--g1) 50%,var(--g2) 50%);opacity:.42}

/* ---------- group cards ---------- */
.groups-row{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:28px}
.gcard{border-radius:28px;padding:30px 30px 30px;color:#fff}
.gcard.one{background:var(--g1)} .gcard.two{background:var(--g2)}
.gtop{display:flex;align-items:flex-end;gap:20px;margin-bottom:22px}
.gtop .big{font-family:var(--display);font-size:6.4rem;line-height:.78;font-feature-settings:"lnum" 1}
.gtop .big .pc{font-family:var(--text);font-weight:600;font-size:.4em;vertical-align:top;position:relative;top:.12em;margin-left:.04em}
.gtop .who{font-size:1.1rem;line-height:1.3;padding-bottom:4px}
.gtop .who b{display:block;font-size:1.45rem;font-weight:600}
.qbox{background:var(--card);color:var(--ink);border-radius:18px;padding:18px 22px 18px;margin-top:12px}
.qbox q{display:block;font-weight:600;font-size:1.12rem;line-height:1.32;margin-bottom:12px}
.qbox.lead q{font-size:1.32rem}
.qbox .lab{font-size:.88rem;color:var(--muted);margin-bottom:6px}
.pcts{display:flex;gap:8px 20px;font-size:.95rem;flex-wrap:wrap}
.pcts span{display:inline-flex;align-items:center;gap:8px}
.pcts b{font-weight:600}
.small-note{font-size:.95rem;color:var(--muted);margin-top:22px;max-width:46rem}

/* ---------- common ground band ---------- */
.common{margin-top:64px;border-radius:28px;background:var(--tint);padding:34px 38px;display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center}
.common q{display:block;font-family:var(--display);font-feature-settings:"lnum" 1;font-size:clamp(1.9rem,3vw,2.6rem);line-height:1.02;margin-top:14px}

/* ---------- dumbbells ---------- */
.dumb{display:block;width:100%;height:auto;margin-top:14px;overflow:visible}
.dumb .trk{stroke:var(--trk,var(--track))}
.dumb .rng{stroke:var(--rng,var(--ink))}
.dumb .tick{fill:var(--tk,var(--muted));font-family:var(--text)}
.dumb .ring{stroke:var(--ring,var(--card))}
.vals{display:flex;gap:8px 22px;font-size:.98rem;margin-top:8px;flex-wrap:wrap}
.vals span{display:inline-flex;align-items:center;gap:8px}
.vals b{font-weight:600}
.nn{color:var(--muted);font-weight:400;font-size:.88em}
.half.agree .nn{color:#333}

/* ---------- pairs ---------- */
.legend{display:flex;gap:26px;font-size:1rem;margin:0 0 32px;flex-wrap:wrap}
.legend span{display:inline-flex;align-items:center;gap:9px}
.pair{display:grid;grid-template-columns:1fr 1fr;border-radius:28px;overflow:hidden;margin-bottom:28px;background:var(--card);color:var(--ink)}
.pair .topic{grid-column:1/-1;display:flex;justify-content:space-between;align-items:baseline;gap:1rem;padding:26px 34px 0}
.pair .topic h3{font-size:2.6rem;line-height:1}
.pair .topic .n{font-size:.9rem;color:var(--muted);white-space:nowrap}
.half{padding:22px 34px 30px}
.half.split{margin:18px 0}
.half.agree{background:var(--fizz);color:#000;margin:18px 18px 18px 0;border-radius:20px;--trk:rgba(0,0,0,.18);--rng:#000;--tk:#333;--ring:var(--fizz)}
.half.agree .pill{background:#000;color:#fff}
.half q{display:block;font-weight:600;font-size:1.32rem;line-height:1.3;min-height:3.9em;margin-top:14px}

/* ---------- still open ---------- */
.open-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}
.ocard{border:2px solid var(--ink);border-radius:28px;padding:30px 32px;background:var(--card)}
.ocard q{display:block;font-weight:600;font-size:1.32rem;line-height:1.3;margin-bottom:22px}
.sbar{display:grid;grid-template-columns:5.6rem 1fr;gap:12px;align-items:center;margin-bottom:12px;font-size:.95rem;font-weight:500}
.sbar .who{display:inline-flex;align-items:center;gap:8px}
.bar{display:flex;height:30px;border-radius:8px;overflow:hidden;background:var(--track)}
.bar i{display:flex;align-items:center;justify-content:center;font-style:normal;font-size:.85rem;font-weight:600}
.bar .a{background:var(--fizz);color:#000;box-shadow:inset 0 0 0 1.5px rgba(0,0,0,.55)}
.bar .p{background:var(--track);color:var(--ink)}
.bar .d{background:var(--ink);color:var(--paper)}
.okey{display:flex;gap:20px;font-size:.92rem;color:var(--muted);margin-top:16px;flex-wrap:wrap}
.okey span{display:inline-flex;align-items:center;gap:7px}
.okey i{width:13px;height:13px;border-radius:3px;display:inline-block}
.ocard .n{font-size:.88rem;color:var(--muted);margin-bottom:10px}

/* ---------- priorities ---------- */
.key{display:flex;gap:22px;font-size:.95rem;margin:0 0 26px;flex-wrap:wrap}
.key span{display:inline-flex;align-items:center;gap:8px}
.key i{width:13px;height:13px;border-radius:50%;display:inline-block}
.prio-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.pcard{background:var(--card);border-radius:24px;padding:26px 26px 24px;display:flex;flex-direction:column;border:2px solid var(--ink)}
@supports (grid-template-rows:subgrid){.pcard{display:grid;grid-row:span 5;grid-template-rows:subgrid;row-gap:0}.pcard .echo{align-self:start}}
.pcard .rank{font-family:var(--display);font-size:3.6rem;line-height:.8;margin-bottom:16px;font-feature-settings:"lnum" 1}
.pcard .tt{margin-bottom:22px;flex:1}
.pcard p.t{font-weight:600;font-size:1.16rem;line-height:1.3}
.pcard p.x{font-size:.9rem;color:var(--muted);margin-top:8px}
.waffle{display:grid;grid-template-columns:repeat(15,1fr);gap:4px;margin-bottom:12px}
.waffle i{aspect-ratio:1;border-radius:50%;background:var(--track)}
.waffle i.y{background:var(--fizz);box-shadow:inset 0 0 0 1.5px rgba(0,0,0,.6)}
.waffle i.n{background:var(--ink)}
.pstats{font-size:.95rem;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.pstats b{font-weight:600}
.no-card{margin-top:28px;background:#000;color:#fff;border-radius:28px;padding:34px 38px;display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center}
.no-card h3{font-size:3rem;line-height:.95;margin:0 0 14px;color:var(--fizz)}
.no-card p.t{font-weight:600;font-size:1.35rem;line-height:1.3;margin-bottom:14px}
.no-card p.s{color:#d0d0d0;font-size:1rem}
.no-card .waffle{max-width:420px}
.no-card .waffle i{background:#3a3a3a}
.no-card .waffle i.y{background:var(--fizz);box-shadow:none}
.no-card .waffle i.n{background:#fff}
details.rest{margin-top:28px;border-top:2px solid var(--ink);padding-top:18px}
details.rest summary{cursor:pointer;font-weight:600;font-size:1.05rem;padding:.2rem 0}
.rest-list{list-style:none;margin:16px 0 0;padding:0}
.rest-list li{display:grid;grid-template-columns:3rem 1fr auto;gap:16px;align-items:baseline;padding:14px 0;border-top:1px solid var(--line)}
.rest-list .r{font-family:var(--display);font-size:2rem;line-height:1;font-feature-settings:"lnum" 1}
.rest-list .t{font-weight:600}
.rest-list .s{font-size:.92rem;color:var(--muted);white-space:nowrap}

/* ---------- at a glance ---------- */
.glance{padding:64px 0 0}
.glance-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.gl{display:flex;flex-direction:column;gap:14px;border-radius:24px;padding:28px 28px 26px;text-decoration:none;color:var(--ink);border:2px solid var(--ink);background:var(--card);transition:transform .15s ease}
.gl:hover{transform:translateY(-3px)}
.gl h3{font-size:2.3rem;line-height:.98}
.gl p{font-size:1rem;line-height:1.45;flex:1}
.gl .more{font-weight:600;font-size:.95rem;text-decoration:underline;text-underline-offset:.2em}
.gl.dark{background:#000;color:#fff;border-color:#000}
.gl.dark h3{color:var(--fizz)}
.gl.tinted{background:var(--tint)}
.split84{display:flex;height:18px;border-radius:99px;overflow:hidden}
.split84 i{display:block;height:100%}
.split84-n{display:flex;justify-content:space-between;font-size:.9rem;font-weight:600;margin-top:-6px}
.split84-n span{display:inline-flex;align-items:center;gap:7px}
.sub-head{margin:88px 0 28px}
.sub-head h3{font-size:clamp(2.4rem,4vw,3.6rem);line-height:.95}
.sub-head p{font-size:1.15rem;line-height:1.45;max-width:32rem}
.deep .common{color:var(--ink);margin:0 0 30px}
.harder{font-size:1.2rem;line-height:1.45;max-width:40rem;color:#d6d6d6;margin:56px 0 22px}
.harder b{color:#fff;font-weight:600}
.finding{font-family:var(--display);font-size:clamp(1.9rem,3vw,2.6rem);line-height:1;margin:0 0 30px;max-width:46rem;font-feature-settings:"lnum" 1}
.echo{border-top:1px solid var(--line);margin-top:18px;padding-top:14px}
.echo .el{font-size:.85rem;font-weight:600;margin-bottom:6px}
.echo q{display:block;font-size:.95rem;line-height:1.38;margin-bottom:4px}
.echo .vals{font-size:.9rem;margin-top:6px}
.next{background:var(--fizz);color:#000;padding:110px 0;position:relative;overflow:hidden}
.next-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:center}
.next h2{font-size:clamp(3.4rem,7vw,6.6rem);line-height:.9;margin-bottom:26px}
.next p{font-size:1.35rem;line-height:1.45;max-width:32rem;margin-bottom:34px}
.next .sticker2{justify-self:center;width:240px;height:240px;border-radius:50%;background:#000;color:var(--fizz);display:grid;place-items:center;text-align:center;transform:rotate(-10deg)}
.next .sticker2 b{font-family:var(--display);font-weight:400;font-size:3.6rem;line-height:.9;display:block}

/* ---------- still open: takeaway ---------- */
.take{display:flex;align-items:center;gap:10px;margin-top:18px;padding-top:16px;border-top:1px solid var(--line);font-weight:600;font-size:1rem}
.take .eq{display:inline-flex;gap:3px}

/* ---------- how the priority vote worked ---------- */
.how{display:grid;grid-template-columns:auto 1fr;gap:40px;align-items:center;background:var(--card);border:2px solid var(--ink);border-radius:24px;padding:26px 32px;margin-bottom:44px}
.costs{display:flex;gap:28px;align-items:flex-end}
.cost{display:flex;flex-direction:column;align-items:center;gap:10px;font-size:.92rem;text-align:center}
.cost b{font-weight:600}
.sq{display:grid;gap:3px}
.sq i{width:16px;height:16px;border-radius:3px;background:var(--fizz);box-shadow:inset 0 0 0 1.5px rgba(0,0,0,.6)}
.sq.s1{grid-template-columns:repeat(1,16px)} .sq.s4{grid-template-columns:repeat(2,16px)} .sq.s9{grid-template-columns:repeat(3,16px)}
.how p.cap{font-size:1.1rem;line-height:1.45;max-width:36rem}

/* ---------- how this worked ---------- */
.steps{list-style:none;margin:0 0 30px;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
.step{display:flex;flex-direction:column;gap:10px;border:2px solid var(--ink);border-radius:24px;padding:24px 24px 26px;background:var(--card)}
.step .fig{font-family:var(--display);font-size:3.8rem;line-height:.85;font-feature-settings:"lnum" 1}
.step h3{font-family:var(--text);font-weight:600;font-size:1.1rem;letter-spacing:0;line-height:1.3;margin-top:6px}
.step p{font-size:.98rem;line-height:1.45;color:var(--muted)}
details.fine{border-top:2px solid var(--ink);padding-top:18px}
details.fine summary{cursor:pointer;font-weight:600;font-size:1.05rem;padding:.2rem 0}
details.fine .arows{margin-top:14px}

/* ---------- about rows ---------- */
.arows{border-bottom:1px solid var(--line)}
.arow{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:32px;padding:24px 0;border-top:1px solid var(--line)}
.arow h3{font-family:var(--text);font-weight:600;font-size:1.12rem;letter-spacing:0;line-height:1.35}
