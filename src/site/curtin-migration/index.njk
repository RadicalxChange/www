function waffle(box, y, n, total = 73) { for (let i = 0; i < total; i++) { const e = document.createElement('i'); if (i < y) e.className = 'y'; else if (i >= total - n) e.className = 'n'; box.appendChild(e); } }
const pg = document.getElementById('prio'), rest = document.getElementById('rest');
QV.forEach((q, i) => {
  if (i < 6) {
    const c = document.createElement('article'); c.className = 'pcard';
    c.innerHTML = `<span class="rank" aria-hidden="true">${i + 1}</span><div class="tt"><p class="t"></p>${q.x ? '<p class="x"></p>' : ''}</div><div class="waffle" role="img" aria-label="${q.y} of 73 backed it, ${q.n} opposed it"></div><div class="pstats"><span><b>${q.y}</b> of 73 backed it</span><span>Net <b>+${q.net}</b> votes</span></div>`;
    c.querySelector('.t').textContent = q.t; if (q.x) c.querySelector('.x').textContent = q.x;
    waffle(c.querySelector('.waffle'), q.y, q.n);
    if (q.e) {
      const ec = document.createElement('div'); ec.className = 'echo';
      ec.innerHTML = `<p class="el">In the conversation, statement ${q.e[0]}</p><q></q><div class="vals"><span><i class="dot g1"></i>Group 1 <b>${q.e[2]}%</b>${q.e[4] && q.e[4] < 20 ? `<span class="nn">(${q.e[4]} voted)</span>` : ''}</span><span><i class="dot g2"></i>Group 2 <b>${q.e[3]}%</b></span></div>${q.en ? '<p class="el" style="margin:6px 0 0;font-weight:400;color:var(--muted)"></p>' : ''}`;
      ec.querySelector('q').textContent = q.e[1];
      if (q.en) ec.querySelectorAll('.el')[1].textContent = q.en;
      c.appendChild(ec);
    }
    pg.appendChild(c);
  } else {
    const li = document.createElement('li');
