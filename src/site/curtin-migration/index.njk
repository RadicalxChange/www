/* ================= priorities ================= */
const QV = [
  { t: 'Set a ten-year population and migration plan, with a published target range, reported to Parliament every year and independently reviewed.', y: 65, n: 3, net: 186, e: [0, 'I’d trust migration more if it was planned 10 to 15 years ahead for what the country needs, not around the three-year election cycle.', 77, 87] },
  { t: 'Plan migration together with housing and infrastructure, so new arrivals are matched by homes and services.', y: 58, n: 7, net: 178, e: [9, 'I’d trust the system more if housing, roads, schools and hospitals kept pace with how many people move into our area.', 75, 71] },
