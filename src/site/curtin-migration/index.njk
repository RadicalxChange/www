  { t: 'Fund universities properly so they rely less on international student fees.', y: 55, n: 10, net: 150, e: [35, 'The government should fund universities properly so they don’t have to rely on international students to stay afloat.', 74, 61, 103, 28] },
  { t: 'Tell people the rules when they apply, and keep those rules for the life of their visa.', y: 57, n: 3, net: 139 },
  { t: 'Let sponsored workers change employers without losing their visa.', y: 53, n: 9, net: 118 },
  { t: 'Spend more on English classes and settlement support, to help newcomers settle in faster.', y: 50, n: 11, net: 113 },
  { t: 'Limit time on temporary visas to a maximum of about eight years.', y: 46, n: 11, net: 78 },
  { t: 'Publish a target to reduce the share of the population on temporary visas.', y: 44, n: 8, net: 73 },
  { t: 'Replace the permanent parent visa with a long-stay family visitor visa, letting parents and grandparents spend extended periods with family here.', y: 47, n: 14, net: 70 }
];
const VOTERS = 72;
const TOPNET = QV[0].net;  // the top change's bar is full width; the others compare with it
const rankOf = q => 1 + QV.filter(o => o.net > q.net).length;  // equal net votes share a place (joint fifth)
const pg = document.getElementById('prio'), rest = document.getElementById('rest');
QV.forEach((q, i) => {
  if (i < 6) {
    const c = document.createElement('article'); c.className = 'pcard';
    c.innerHTML = `<span class="rank" aria-hidden="true">${rankOf(q)}</span><div class="tt"><p class="t"></p>${q.x ? '<p class="x"></p>' : ''}</div><div class="tally"><p class="big">+${q.net}<span>net votes</span></p><div class="tbar" aria-hidden="true"><i style="width:${(q.net / TOPNET * 100).toFixed(1)}%"></i></div></div><div class="pstats"><span>${q.y} of ${VOTERS} backed it, ${q.n} opposed</span></div>`;
    c.querySelector('.t').textContent = q.t; if (q.x) c.querySelector('.x').textContent = q.x;
    if (q.e) {
      const ec = document.createElement('div'); ec.className = 'echo';
      ec.innerHTML = `<p class="el">In the conversation, statement ${q.e[0]}</p><q></q><div class="vals"><span><i class="dot g1"></i>Group 1 <b>${q.e[2]}%</b>${q.e[4] < 20 ? `<span class="nn">(${q.e[4]} voted)</span>` : ''}</span><span><i class="dot g2"></i>Group 2 <b>${q.e[3]}%</b>${q.e[5] < 20 ? `<span class="nn">(${q.e[5]} voted)</span>` : ''}</span></div>${q.en ? '<p class="el" style="margin:6px 0 0;font-weight:400;color:var(--muted)"></p>' : ''}`;
      ec.querySelector('q').textContent = q.e[1];
      if (q.en) ec.querySelectorAll('.el')[1].textContent = q.en;
      c.appendChild(ec);
    }
    pg.appendChild(c);
  } else {
    const li = document.createElement('li');
    li.innerHTML = `<span class="r">${rankOf(q)}</span><span class="t"></span><span class="s"><b class="rnet">+${q.net}</b><span class="rs">${q.y} of ${VOTERS} backed it</span></span>`;
    li.querySelector('.t').textContent = q.t; rest.appendChild(li);
  }
});
</script>
