/* ================= dumbbells: one dot per group ================= */
function dumbbell(vs, ns) {
  const small = n => n && n < 20 ? `<span class="nn">(${n} voted)</span>` : '';
  const wrap = document.createElement('div');
  const W = 600, H = 58, L = 16, R = W - 16, Y = 22, x = v => L + (R - L) * v / 100;
  const s = el('svg', { viewBox: `0 0 ${W} ${H}`, class: 'dumb', role: 'img', 'aria-label': vs.map((v, g) => `${NAME[g]}: ${v}% agree.`).join(' ') });
  el('line', { x1: L, x2: R, y1: Y, y2: Y, class: 'trk', 'stroke-width': 6, 'stroke-linecap': 'round' }, s);
  [[0, 'start'], [100, 'end']].forEach(([v, anc]) => { const t = el('text', { x: x(v), y: H - 2, 'font-size': 15, class: 'tick', 'text-anchor': anc }, s); t.textContent = v + '%'; });
  el('line', { x1: x(Math.min(...vs)), x2: x(Math.max(...vs)), y1: Y, y2: Y, class: 'rng', 'stroke-width': 6 }, s);
  // groups with the same share share one dot, split into slices
  const at = new Map(); vs.forEach((v, g) => at.set(v, (at.get(v) || []).concat(g)));
  [...at.keys()].sort((a, b) => a - b).forEach(v => {
    const gs = at.get(v), cx = x(v), r = 14;
    if (gs.length === 1) { el('circle', { cx, cy: Y, r, fill: GC[gs[0]], class: 'ring', 'stroke-width': 3 }, s); return; }
    gs.forEach((g, j) => {
      const a0 = 2 * Math.PI * j / gs.length - Math.PI / 2, a1 = 2 * Math.PI * (j + 1) / gs.length - Math.PI / 2;
      el('path', { d: `M${cx},${Y} L${(cx + r * Math.cos(a0)).toFixed(2)},${(Y + r * Math.sin(a0)).toFixed(2)} A${r},${r} 0 0 1 ${(cx + r * Math.cos(a1)).toFixed(2)},${(Y + r * Math.sin(a1)).toFixed(2)} Z`, fill: GC[g] }, s);
    });
    el('circle', { cx, cy: Y, r, fill: 'none', class: 'ring', 'stroke-width': 3 }, s);
  });
  wrap.appendChild(s);
  const vals = document.createElement('div'); vals.className = 'vals';
  vals.innerHTML = vs.map((v, g) => `<span><i class="dot g${g + 1}"></i>${NAME[g]} <b>${v}%</b>${small(ns[g])}</span>`).join('');
  wrap.appendChild(vals);
  return wrap;
}

