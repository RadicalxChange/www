  people.forEach(p => { p.x = PL + p.nx * (MW - PL - PR); p.y = PT + p.ny * (MH - PT - PB); });
  while (axisLayer.firstChild) axisLayer.removeChild(axisLayer.firstChild);
  const axY = MH - 44, fs = Math.max(17, 12.5 * k);
  el('line', { x1: PL, x2: MW - PR - 4, y1: axY, y2: axY, class: 'axis', 'marker-start': 'url(#arr)', 'marker-end': 'url(#arr)' }, axisLayer);
  el('line', { x1: 22, x2: 22, y1: PT + 4, y2: axY - 18, class: 'axis', 'marker-start': 'url(#arr)', 'marker-end': 'url(#arr)' }, axisLayer);
  const lab = (txt, attrs) => { const tx = el('text', Object.assign({ class: 'axis-label' }, attrs), axisLayer); tx.style.fontSize = fs + 'px'; tx.textContent = txt; };
  const left = w < 640 ? 'Fewer, more slowly' : 'Fewer migrants, more slowly';
  lab(left, { x: PL, y: MH - 10 });
  lab('Migration is working', { x: MW - PR, y: MH - 10, 'text-anchor': 'end' });
  lab('Agreed more often', { 'text-anchor': 'end', transform: `translate(${22 + 12 + fs * .8} ${PT + 6}) rotate(-90)` });
  lab('Agreed less often', { 'text-anchor': 'start', transform: `translate(${22 + 12 + fs * .8} ${axY - 22}) rotate(-90)` });
  const r = Math.min(14, Math.max(8, 3.6 * k));
  dots.forEach(d => d.setAttribute('r', r.toFixed(1)));
  ring.setAttribute('r', (r + 6).toFixed(1));
  if (settled) { dots.forEach((d, i) => { d.style.transition = 'none'; d.style.transform = `translate(${people[i].x}px, ${people[i].y}px)`; }); svg.getBoundingClientRect(); dots.forEach(d => d.style.transition = ''); }
  hidePerson && hidePerson();
}
function placeAll(final) {
  dots.forEach((d, i) => {
    const p = people[i];
    const x = final ? p.x : MW / 2 + (Math.sin(i * 12.9898) * 43758.5453 % 1) * 160;
    const y = final ? p.y : (MH - PB) / 2 + (Math.sin(i * 78.233) * 12345.678 % 1) * 90;
    d.style.transform = `translate(${x}px, ${y}px)`;
  });
  if (final) settled = true;
}
var hidePerson = null;
layout();
let lastW = svg.clientWidth;
window.addEventListener('resize', () => { clearTimeout(window.__rz); window.__rz = setTimeout(() => { if (svg.clientWidth !== lastW) { lastW = svg.clientWidth; layout(); } }, 150); });

if (reduce || !('IntersectionObserver' in window)) { placeAll(true); dots.forEach((d, i) => { d.style.opacity = finalOp(people[i]); }); }
else {
  dots.forEach(d => { d.style.transition = 'none'; d.style.opacity = .35; d.style.fill = 'var(--muted)'; });
  placeAll(false);
  svg.getBoundingClientRect();
  const io = new IntersectionObserver(es => { if (!es[0].isIntersecting) return; io.disconnect();
    dots.forEach((d, i) => { d.style.transition = ''; d.style.transitionDelay = ((i * 37 % 100) / 220).toFixed(2) + 's'; });
    requestAnimationFrame(() => placeAll(true));
    setTimeout(() => dots.forEach((d, i) => { d.style.transitionDelay = '0s'; d.style.opacity = finalOp(people[i]); d.style.fill = finalFill(people[i]); }), 1500);
  }, { threshold: .35 });
  io.observe(svg);
}

// person card
const card = document.getElementById('person');
const mapCard = document.getElementById('map-card');
let current = -1;
const NAME = ['Group 1', 'Group 2'], FULL = ['Group 1: Pace and control', 'Group 2: Migration works'];
const VERB = { a: 'agreed', d: 'disagreed' };
function example(id, v, side) {
  if (id < 0) return '';
  return `<div class="ex"><p class="exl"><i class="dot ${side ? 'g2' : 'g1'}"></i>Like ${NAME[side]}, they ${VERB[v]}:</p><q>${esc(DATA.texts[String(id)])}</q></div>`;
}
function showPerson(i) {
  if (i === current && card.classList.contains('on')) return;
  current = i; const p = people[i], me = p.g, other = 1 - p.g;
  const wrote = p.nc > 0 ? `, and wrote <b>${p.nc}</b> of their own` : '';
  let html = `<p class="pg"><i class="dot ${me ? 'g2' : 'g1'}"></i>${FULL[me]}</p>
    <p class="pn">Voted on <b>${p.nv}</b> statements, agreeing with <b>${p.ar}%</b>${wrote}.</p>`;
  if (p.n === 0) {
    html += `<p class="note">They didn’t vote on any of the ${DATA.nsplit} statements where the groups took opposite sides, so they were placed using their other votes.</p>`;
  } else {
    const w1 = (p.l1 / p.n * 100).toFixed(1), w2 = (p.l2 / p.n * 100).toFixed(1);
    html += `<p class="lean-h">On the ${DATA.nsplit} statements that split the groups, they voted on ${p.n}:</p>
      <div class="lean" aria-hidden="true"><i class="l1" style="width:${w1}%"></i><i class="l2" style="width:${w2}%"></i></div>
      <div class="lean-n"><span><i class="dot g1"></i>Like Group 1: <b>${p.l1}</b></span><span>Like Group 2: <b>${p.l2}</b><i class="dot g2"></i></span></div>`;
    let note;
    if (p.share >= .65) note = `Mostly in line with the rest of ${NAME[me]}.`;
    else if (p.share >= .5) note = `They sit near the border, voting partly like each group.`;
    else note = `On these they voted more like ${NAME[other]}, but they were placed in ${NAME[me]} using all of their votes. With only ${p.n} of these statements to go on, they sit right at the border.`;
    html += `<p class="note">${note}</p>`;
    // examples: one from each side if possible, own group's side first
    const ex = [];
    const mine = me ? [p.e2, p.v2, 1] : [p.e1, p.v1, 0], theirs = me ? [p.e1, p.v1, 0] : [p.e2, p.v2, 1];
    if (mine[0] >= 0) ex.push(mine); if (theirs[0] >= 0) ex.push(theirs);
    html += ex.slice(0, 2).map(([id, v, s]) => example(id, v, s)).join('');
  }
  card.innerHTML = html;
  ring.setAttribute('cx', p.x); ring.setAttribute('cy', p.y); ring.setAttribute('opacity', 1);
  card.classList.add('on');
  if (window.matchMedia('(max-width: 900px)').matches) return;
  const box = svg.getBoundingClientRect(), cb = mapCard.getBoundingClientRect();
  const px = box.left - cb.left + p.x / MW * box.width, py = box.top - cb.top + p.y / MH * box.height;
  const w = card.offsetWidth, h = card.offsetHeight;
  const left = px > cb.width / 2 ? px - w - 26 : px + 26;
  const top = Math.min(Math.max(py - h / 2, 10), cb.height - h - 10);
  card.style.left = left + 'px'; card.style.top = top + 'px';
}
hidePerson = function () { card.classList.remove('on'); ring.setAttribute('opacity', 0); current = -1; };
function nearest(evt) {
  const pt = svg.createSVGPoint(); pt.x = evt.clientX; pt.y = evt.clientY;
  const m = svg.getScreenCTM(); if (!m) return -1;
  const q = pt.matrixTransform(m.inverse());
  let best = -1, bd = Infinity;
  people.forEach((p, i) => { const d = (p.x - q.x) ** 2 + (p.y - q.y) ** 2; if (d < bd) { bd = d; best = i; } });
  const lim = (MW / (svg.clientWidth || MW)) * 22;
  return bd <= lim * lim ? best : -1;
}
svg.addEventListener('pointermove', e => { if (e.pointerType !== 'mouse') return; const i = nearest(e); if (i < 0) hidePerson(); else showPerson(i); });
svg.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse') hidePerson(); });
svg.addEventListener('click', e => { const i = nearest(e); if (i >= 0) showPerson(i); });
const candidates = people.filter(p => p.n >= 3).map(p => p.i);
document.getElementById('someone').addEventListener('click', () => {
  let i; do { i = candidates[Math.floor(Math.random() * candidates.length)]; } while (i === current && candidates.length > 1);
  placeAll(true); dots.forEach((d, j) => { d.style.opacity = finalOp(people[j]); d.style.fill = finalFill(people[j]); });
  showPerson(i);
});

/* ================= dumbbells ================= */
function dumbbell(a, b, n1) {
  const small = n1 && n1 < 20 ? `<span class="nn">(${n1} voted)</span>` : '';
  const wrap = document.createElement('div');
  const W = 600, H = 58, L = 16, R = W - 16, Y = 22, x = v => L + (R - L) * v / 100;
  const s = el('svg', { viewBox: `0 0 ${W} ${H}`, class: 'dumb', role: 'img', 'aria-label': `Group 1: ${a}% agree. Group 2: ${b}% agree.` });
  el('line', { x1: L, x2: R, y1: Y, y2: Y, class: 'trk', 'stroke-width': 6, 'stroke-linecap': 'round' }, s);
  [[0, 'start'], [100, 'end']].forEach(([v, anc]) => { const t = el('text', { x: x(v), y: H - 2, 'font-size': 15, class: 'tick', 'text-anchor': anc }, s); t.textContent = v + '%'; });
  el('line', { x1: x(Math.min(a, b)), x2: x(Math.max(a, b)), y1: Y, y2: Y, class: 'rng', 'stroke-width': 6 }, s);
  if (a === b) {
    const cx = x(a), r = 14;
    el('path', { d: `M${cx},${Y - r} A${r},${r} 0 0 0 ${cx},${Y + r} Z`, fill: 'var(--g1)' }, s);
    el('path', { d: `M${cx},${Y - r} A${r},${r} 0 0 1 ${cx},${Y + r} Z`, fill: 'var(--g2)' }, s);
    el('circle', { cx, cy: Y, r, fill: 'none', class: 'ring', 'stroke-width': 3 }, s);
  } else {
    [[b, 'var(--g2)'], [a, 'var(--g1)']].forEach(([v, c]) => el('circle', { cx: x(v), cy: Y, r: 14, fill: c, class: 'ring', 'stroke-width': 3 }, s));
  }
  wrap.appendChild(s);
  const vals = document.createElement('div'); vals.className = 'vals';
  vals.innerHTML = a === b
    ? `<span><i class="dot g1"></i><i class="dot g2" style="margin-left:-4px"></i><b>${a}%</b> of both groups agree</span>`
    : `<span><i class="dot g1"></i>Group 1 <b>${a}%</b>${small}</span><span><i class="dot g2"></i>Group 2 <b>${b}%</b></span>`;
  wrap.appendChild(vals);
  return wrap;
}

const PAIRS = [
  { topic: 'Temporary or permanent?', split: { id: 69, t: 'A temporary visa should not lead to permanent residency.', a: 94, b: 16, n: 17 }, agree: { id: 12, t: 'For seasonal work like seeding and harvest, short-term visas work well: people come, do the hard work, get paid and move on.', a: 83, b: 83 } },
  { topic: 'How many, how fast?', split: { id: 3, t: 'For me, trust comes down to the numbers: too many people have arrived too quickly for our communities to keep up.', a: 89, b: 25 }, agree: { id: 9, t: 'I’d trust the system more if housing, roads, schools and hospitals kept pace with how many people move into our area.', a: 75, b: 71 } },
  { topic: 'Planning ahead', split: { id: 2, t: 'For me, trust is less about how many people come here and more about whether anyone is clearly in charge of the plan.', a: 20, b: 69 }, agree: { id: 0, t: 'I’d trust migration more if it was planned 10 to 15 years ahead for what the country needs, not around the three-year election cycle.', a: 77, b: 87 } },
  { topic: 'Who should we choose?', split: { id: 73, t: 'We should prioritise migrants from countries who are likely to assimilate into Australian society', a: 90, b: 32 }, agree: { id: 78, t: 'Migrants should commit to respecting Australian laws and values.', a: 100, b: 82, n: 17 } },
  { topic: 'Who should pay?', split: { id: 28, t: 'People who choose to come here should be expected to cover more of the cost of settling in, including learning English.', a: 90, b: 33 }, agree: { id: 139, t: 'The cost of dependents for temporary visa holders should be transparent.', a: 100, b: 78, n: 17 } }
];
const pairsRoot = document.getElementById('pairs');
PAIRS.forEach(p => {
