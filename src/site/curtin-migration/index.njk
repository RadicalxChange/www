  const vals = document.createElement('div'); vals.className = 'vals';
  vals.innerHTML = a === b
    ? `<span><i class="dot g1"></i><i class="dot g2" style="margin-left:-4px"></i><b>${a}%</b> of both groups agree</span>`
    : `<span><i class="dot g1"></i>Group 1 <b>${a}%</b>${small}</span><span><i class="dot g2"></i>Group 2 <b>${b}%</b></span>`;
  wrap.appendChild(vals);
  return wrap;
}

const PAIRS = [
  { topic: 'Temporary or permanent?', split: { id: 69, t: 'A temporary visa should not lead to permanent residency.', a: 94, b: 16, n: 17 }, agree: { id: 12, t: 'For seasonal work like seeding and harvest, short-term visas work well: people come, do the hard work, get paid and move on.', a: 83, b: 83 } },
  { topic: 'How many, how fast?', split: { id: 3, t: 'For me, trust comes down to the numbers: too many people have arrived too quickly for our communities to keep up.', a: 89, b: 25 }, agree: { id: 9, t: 'I’d trust the system more if housing, roads, schools and hospitals kept pace with how many people move into our area.', a: 75, b: 71 } },
  { topic: 'Planning ahead', split: { id: 2, t: 'For me, trust is less about how many people come here and more about whether anyone is clearly in charge of the plan.', a: 20, b: 69 }, agree: { id: 0, t: 'I’d trust migration more if it was planned 10 to 15 years ahead for what the country needs, not around the three-year election cycle.', a: 77, b: 87 } },
  { topic: 'Who should we choose?', split: { id: 73, t: 'We should prioritise migrants from countries who are likely to assimilate into Australian society', a: 90, b: 32 }, agree: { id: 78, t: 'Migrants should commit to respecting Australian laws and values.', a: 100, b: 82, n: 17 } },
  { topic: 'Who should pay?', split: { id: 28, t: 'People who choose to come here should be expected to cover more of the cost of settling in, including learning English.', a: 90, b: 33 }, agree: { id: 139, t: 'The cost of dependents for temporary visa holders should be transparent.', a: 100, b: 78, n: 17 } }
];
const pairsRoot = document.getElementById('pairs');
PAIRS.forEach(p => {
  const d = document.createElement('article'); d.className = 'pair';
  d.innerHTML = `<div class="topic"><h3></h3><span class="n">Statements ${p.split.id} and ${p.agree.id}</span></div>
    <div class="half split"><span class="pill">They split</span><q></q></div>
    <div class="half agree"><span class="pill">They agree</span><q></q></div>`;
  d.querySelector('h3').textContent = p.topic;
  const [qs, qa] = d.querySelectorAll('q'); qs.textContent = p.split.t; qa.textContent = p.agree.t;
  d.querySelector('.split').appendChild(dumbbell(p.split.a, p.split.b, p.split.n));
  d.querySelector('.agree').appendChild(dumbbell(p.agree.a, p.agree.b, p.agree.n));
  pairsRoot.appendChild(d);
});

/* ================= unlikely allies: the same map, with the people who backed both lit up ================= */
(function () {
  const svgA = document.getElementById('amap'); if (!svgA) return;
  const A = DATA.allies;
  const defsA = el('defs', {}, svgA);
  const mkA = el('marker', { id: 'arrA', viewBox: '0 0 10 10', refX: 8, refY: 5, markerWidth: 7, markerHeight: 7, orient: 'auto-start-reverse' }, defsA);
  el('path', { d: 'M0,0 L10,5 L0,10 z', fill: 'var(--ink)' }, mkA);
  const axes = el('g', {}, svgA), back = el('g', {}, svgA), front = el('g', {}, svgA);
  const dotsA = people.map((p, i) => A[i] === 'b'
    ? el('circle', { fill: 'var(--fizz)', stroke: 'var(--ink)', 'stroke-width': 2, class: 'ally-dot' }, front)
    : el('circle', { fill: p.g === 0 ? 'var(--g1)' : 'var(--g2)', 'fill-opacity': A[i] === 'v' ? .32 : .16 }, back));
  function drawA() {
    const w = svgA.clientWidth || MW, sw = swarm(w), k = sw.k, H = sw.H;
    svgA.setAttribute('viewBox', `0 0 ${MW} ${H}`);
    while (axes.firstChild) axes.removeChild(axes.firstChild);
    const axY = sw.base + 8, fs = Math.max(17, 12.5 * k);
    el('line', { x1: PL, x2: MW - PR - 4, y1: axY, y2: axY, class: 'axis', 'marker-start': 'url(#arrA)', 'marker-end': 'url(#arrA)' }, axes);
    const lab = (txt, attrs) => { const tx = el('text', Object.assign({ class: 'axis-label' }, attrs), axes); tx.style.fontSize = fs + 'px'; tx.textContent = txt; return tx; };
    const lt = lab(w < 640 ? 'Fewer, more slowly' : 'Fewer migrants, more slowly', { x: PL, y: axY + fs * 1.6 });
    const rt = lab('Migration is working', { x: MW - PR, y: axY + fs * 1.6, 'text-anchor': 'end' });
    const room = MW - PL - PR - 40, used = lt.getBBox().width + rt.getBBox().width;  // never let the two labels touch
    if (used > room) [lt, rt].forEach(tx => tx.style.fontSize = (fs * room / used).toFixed(1) + 'px');
    sw.pos.forEach(q => {
      const d = dotsA[q.i];
      d.setAttribute('cx', q.x.toFixed(1));
      d.setAttribute('cy', q.y.toFixed(1));
      d.setAttribute('r', sw.r.toFixed(2));  // allies stand out by colour; heaps pack dots too closely to enlarge them
    });
  }
  drawA();
  let lastWA = svgA.clientWidth;
  window.addEventListener('resize', () => { clearTimeout(window.__rzA); window.__rzA = setTimeout(() => { if (svgA.clientWidth !== lastWA) { lastWA = svgA.clientWidth; drawA(); } }, 150); });
})();

/* ================= priorities ================= */
const QV = [
  { t: 'Set a ten-year population and migration plan, with a published target range, reported to Parliament every year and independently reviewed.', y: 65, n: 3, net: 186, e: [0, 'I’d trust migration more if it was planned 10 to 15 years ahead for what the country needs, not around the three-year election cycle.', 77, 87] },
  { t: 'Plan migration together with housing and infrastructure, so new arrivals are matched by homes and services.', y: 58, n: 7, net: 178, e: [9, 'I’d trust the system more if housing, roads, schools and hospitals kept pace with how many people move into our area.', 75, 71] },
  { t: 'Ban employers caught exploiting visa workers from sponsoring anyone again.', y: 65, n: 4, net: 177, e: [76, 'Employers who exploit migrant workers should lose the right to sponsor visas.', 82, 95, 17] },
  { t: 'Create a dedicated visa pathway for aged care, disability and other care workers.', y: 59, n: 6, net: 172, e: [24, 'Australia needs more than top professionals. We rely on aged care and disability workers from overseas, so there should be a real visa pathway for them even though the pay is low.', 47, 92], en: 'The exception: Group 1 was split.' },
  { t: 'Remove people with no right to stay more quickly.', y: 54, n: 8, net: 161, x: '5 people gave this 7 or more votes, the most intense support for any change.', e: [140, 'People overstaying their visa must leave Australia and should not be allowed to reapply for 3 years.', 85, 57, 13], en: 'Group 2 was more divided on this one.' },
  { t: 'Fund universities properly so they rely less on international student fees.', y: 55, n: 10, net: 151, e: [35, 'The government should fund universities properly so they don’t have to rely on international students to stay afloat.', 61, 73] },
  { t: 'Tell people the rules when they apply, and keep those rules for the life of their visa.', y: 57, n: 4, net: 138 },
  { t: 'Let sponsored workers change employers without losing their visa.', y: 53, n: 10, net: 113 },
  { t: 'Spend more on English classes and settlement support, to help newcomers settle in faster.', y: 50, n: 11, net: 112 },
  { t: 'Limit time on temporary visas to a maximum of about eight years.', y: 46, n: 11, net: 78 },
  { t: 'Replace the permanent parent visa with a long-stay family visitor visa, letting parents and grandparents spend extended periods with family here.', y: 47, n: 14, net: 74 },
  { t: 'Publish a target to reduce the share of the population on temporary visas.', y: 43, n: 8, net: 71 }
];
function waffle(box, y, n, total = 73) { for (let i = 0; i < total; i++) { const e = document.createElement('i'); if (i < y) e.className = 'y'; else if (i >= total - n) e.className = 'n'; box.appendChild(e); } }
const pg = document.getElementById('prio'), rest = document.getElementById('rest');
QV.forEach((q, i) => {
  if (i < 6) {
    const c = document.createElement('article'); c.className = 'pcard';
    c.innerHTML = `<span class="rank" aria-hidden="true">${i + 1}</span><div class="tt"><p class="t"></p>${q.x ? '<p class="x"></p>' : ''}</div><div class="waffle" role="img" aria-label="${q.y} of 73 backed it, ${q.n} opposed it"></div><div class="pstats"><span><b>${q.y}</b> of 73 backed it</span><span>Net <b>+${q.net}</b> votes</span></div>`;
    c.querySelector('.t').textContent = q.t; if (q.x) c.querySelector('.x').textContent = q.x;
    waffle(c.querySelector('.waffle'), q.y, q.n);
    if (q.e) {
      const ec = document.createElement('div'); ec.className = 'echo';
      ec.innerHTML = `<p class="el">In the conversation, statement ${q.e[0]}</p><q></q><div class="vals"><span><i class="dot g1"></i>Group 1 <b>${q.e[2]}%</b>${q.e[4] && q.e[4] < 20 ? `<span class="nn">(${q.e[4]} voted)</span>` : ''}</span><span><i class="dot g2"></i>Group 2 <b>${q.e[3]}%</b></span></div>${q.en ? '<p class="el" style="margin:6px 0 0;font-weight:400;color:var(--muted)"></p>' : ''}`;
      ec.querySelector('q').textContent = q.e[1];
      if (q.en) ec.querySelectorAll('.el')[1].textContent = q.en;
      c.appendChild(ec);
    }
    pg.appendChild(c);
  } else {
    const li = document.createElement('li');
    li.innerHTML = `<span class="r">${i + 1}</span><span class="t"></span><span class="s"><b>${q.y}</b> of 73 backed it, net +${q.net}</span>`;
    li.querySelector('.t').textContent = q.t; rest.appendChild(li);
  }
});
waffle(document.getElementById('nowaffle'), 13, 44);
