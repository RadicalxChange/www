  { t: 'Remove people with no right to stay more quickly.', y: 54, n: 8, net: 161, x: '5 people gave this 7 or more votes, the most intense support for any change.', e: [140, 'People overstaying their visa must leave Australia and should not be allowed to reapply for 3 years.', 85, 57, 13], en: 'Group 2 was more divided on this one.' },
