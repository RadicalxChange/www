---
title: "Every statement — ASPIRE Policy Lab"
description: "The full statement-level record of the ASPIRE National Forum Policy Lab Pol.is deliberation: every statement with room-wide tallies and per-group agree rates."
---

<!-- prettier-ignore -->
{% extends "layouts/_base.njk" %}

<!-- prettier-ignore -->
{% import "components/menu.njk" as menu %}
<!-- prettier-ignore -->
{% import "components/footer.njk" as footer %}

<!-- prettier-ignore -->
{% set R = aspire.results %}
<!-- prettier-ignore -->
{% set C = aspire.content %}
<!-- prettier-ignore -->
{% set S = R.statements %}

{# Same head treatment as the main results page: no analytics, no KaTeX. #}
<!-- prettier-ignore -->
{% block headScripts %}
<script
  defer
  src="https://unpkg.com/body-scroll-lock@3.0.2/lib/bodyScrollLock.min.js"
  integrity="sha384-TPD9y0kmdvgK9D4a+br/KYlqMn9cLVXHDVxxN93FvPj+13bPJeMJZaXAB7+p/e7X"
  crossorigin="anonymous"
></script>
<!-- prettier-ignore -->
{% endblock %}

<!-- prettier-ignore -->
{% block mathStyles %}
<!-- prettier-ignore -->
{% endblock %}

{% macro thinGlyph(t) %}{% if t.thin %}<span class="gr-thin"><span aria-hidden="true">◔</span><span class="sr-only"> (thin)</span></span>{% endif %}{% endmacro %}

{% macro countsLine(t) %}{{ t.agrees }} agree · {{ t.disagrees }} disagree · {{ t.passes }} pass · n={{ t.votes }}{% endmacro %}

{% macro groupName(key) %}{% for grp in C.groups.list %}{% if grp.key == key %}{{ grp.name }}{% endif %}{% endfor %}{% endmacro %}

<!-- prettier-ignore -->
{% block body %}
{{ menu.render() }}

<main class="geneva aspire-cb">

  <header class="grid grid-cols-layout-4 lg:grid-cols-layout-12 pt-12 lg:pt-16 pb-8">
    <div class="col-span-columns lg:col-start-column-1 lg:col-end-margin-2">
      <p class="gr-kicker mb-4"><a class="underline" href="/aspire-canberra-policy-lab/">← ASPIRE Policy Lab — Results</a></p>
      <h1 class="gr-hero-question mb-6" style="font-size: clamp(1.8rem, 4.5vw, 3.2rem)">{{ C.data_page.title }}</h1>
      <p class="gr-prose mb-3">{{ C.data_page.intro }}</p>
      <p class="text-size--1"><a class="underline font-bold" href="{{ C.data_page.csv_path }}" download>{{ C.data_page.csv_label }}</a></p>
    </div>
  </header>

  <section id="explorer" class="grid grid-cols-layout-4 lg:grid-cols-layout-12 pb-16">
    <div class="col-span-columns lg:col-start-column-1 lg:col-end-margin-2">
      <p class="gr-legend mb-4"><span>{{ C.legend_note }} Thin cells are greyed.</span></p>
      <div id="gr-filters" class="flex flex-wrap gap-2 mb-4" hidden>
        <button type="button" class="gr-filter" data-sort="id" data-dir="asc" aria-pressed="true">In order</button>
        <button type="button" class="gr-filter" data-sort="minagree" data-dir="desc" aria-pressed="false">Most consensus</button>
        <button type="button" class="gr-filter" data-sort="div" data-dir="desc" aria-pressed="false">Most divisive</button>
        <button type="button" class="gr-filter" data-sort="passrate" data-dir="desc" aria-pressed="false">Most passed</button>
      </div>
      <div class="gr-table-wrap">
        <table class="gr-table" id="gr-explorer-table">
          <thead>
            <tr>
              <th scope="col" class="gr-num" data-key="id">#</th>
              <th scope="col" data-key="text">Statement</th>
              <th scope="col" class="gr-num" data-key="agrees">Agree</th>
              <th scope="col" class="gr-num" data-key="disagrees">Disagree</th>
              <th scope="col" class="gr-num" data-key="passes">Pass</th>
              {% for g in ["A", "B", "C"] %}
              <th scope="col" class="gr-num" data-key="g{{ g | lower }}" title="Group {{ g }} — {{ groupName(g) }} agree rate"><span class="gr-text-{{ g }}">{{ g }}</span>&nbsp;agree</th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for key, s in S %}
            {% if not s.junk and not s.rejected and s.text %}
            <tr
              id="s{{ s.id }}"
              data-id="{{ s.id }}"
              data-agrees="{{ s.total.agrees }}"
              data-disagrees="{{ s.total.disagrees }}"
              data-passes="{{ s.total.passes }}"
              data-passrate="{{ s.pass_rate }}"
              data-minagree="{{ s.consensus_min_agree_rate if s.consensus_min_agree_rate != null else -1 }}"
              data-div="{{ s.divisiveness if s.divisiveness != null else -1 }}"
              data-ga="{{ s.groups.A.agree_rate if s.groups.A.votes > 0 else -1 }}"
              data-gb="{{ s.groups.B.agree_rate if s.groups.B.votes > 0 else -1 }}"
              data-gc="{{ s.groups.C.agree_rate if s.groups.C.votes > 0 else -1 }}"
            >
              <td class="gr-num">{{ s.id }}</td>
              <td><span class="gr-stmt-text">{{ s.text }}</span> <span class="gr-badge {% if s.source == 'live' %}text-black{% else %}text-gray{% endif %}">{{ "written live" if s.source == "live" else "seed" }}</span></td>
              <td class="gr-num">{{ s.total.agrees }}</td>
              <td class="gr-num">{{ s.total.disagrees }}</td>
              <td class="gr-num">{{ s.total.passes }}</td>
              {% for g in ["A", "B", "C"] %}
              {% set t = s.groups[g] %}
              <td class="gr-num{% if t.thin %} gr-cell-thin{% endif %}" title="Group {{ g }} — {{ groupName(g) }}: {{ countsLine(t) }}">{% if t.votes > 0 %}{{ (t.agree_rate * 100) | round }}%{% else %}–{% endif %}{{ thinGlyph(t) }}</td>
              {% endfor %}
            </tr>
            {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="gr-counts mt-3">“Most consensus” ranks by the lowest agree rate across the three groups (a statement only ranks high if all agree); “most divisive” by the spread of net agreement between them. Statements with fewer than {{ R.rules.min_group_votes_for_rankings }} votes in any group are unranked and sort last.</p>
      <p class="gr-counts mt-2">{{ C.footer.data_note_full }}</p>
    </div>
  </section>

</main>

{{ footer.render() }}

<script src="/js/geneva-reflections.js" defer></script>
<script>
  // prettier-ignore
  {% include "components/menu.js" %}
</script>
<!-- prettier-ignore -->
{% endblock %}
